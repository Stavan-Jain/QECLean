    family-names: Jain
  - given-names: Aws
    family-names: Albarghouthi
version: 0.2.0
date-released: "2026-11-19"
license: Apache-2.0
repository-code: "https://github.com/QECLean/QECLean"
keywords:
  - Lean 4
  - mathlib
  - formal verification
  - quantum error correction
  - stabilizer codes
