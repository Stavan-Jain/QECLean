import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.GroupTheory.Subgroup.Centralizer
import QEC.Stabilizer.Framework.Core.Stabilizer.StabilizerGroup
import QEC.Stabilizer.Framework.Core.Stabilizer.SubgroupLemmas
import QEC.Stabilizer.Foundations.PauliGroup
import QEC.Stabilizer.Foundations.PauliGroup.Commutation

/-!
# Centralizer of a stabilizer group

The centralizer of a stabilizer group `S` is the subgroup of the n-qubit Pauli
group of elements commuting with every element of `S`. These are exactly the
Pauli operators that map the codespace to itself.

Main results:

- `StabilizerGroup.centralizer S`, with `mem_centralizer_iff` and, for a group
  generated by a set, `mem_centralizer_iff_closure`;
- `StabilizerGroup.pauliNormalizer_eq_centralizer`: because `-I ∉ S`, the
  normalizer of `S` in the Pauli group is its centralizer;
- `StabilizerGroup.stabilizer_le_centralizer`: `S` lies in its centralizer;
- `StabilizerGroup.not_mem_stabilizer_of_anticommutes_centralizer`: an element
  that anticommutes with some element of the centralizer is not in `S`.
-/

namespace Quantum
namespace StabilizerGroup

variable {n : ℕ}

/-- The centralizer of a stabilizer group `S`: all Pauli group elements that
commute with every element of `S`. -/
noncomputable def centralizer (S : StabilizerGroup n) : Subgroup (NQubitPauliGroupElement n) :=
  Subgroup.centralizer (S.toSubgroup : Set (NQubitPauliGroupElement n))

/-- The centralizer depends only on the underlying subgroup. -/
lemma centralizer_eq_of_toSubgroup_eq (S T : StabilizerGroup n) (h : S.toSubgroup = T.toSubgroup) :
    centralizer S = centralizer T := by
  rw [centralizer, centralizer, h]

/-- Membership in the centralizer is commuting with every element of the
stabilizer group. -/
lemma mem_centralizer_iff (g : NQubitPauliGroupElement n) (S : StabilizerGroup n) :
    g ∈ centralizer S ↔ ∀ h ∈ S.toSubgroup, h * g = g * h :=
  Subgroup.mem_centralizer_iff

/-- When the stabilizer subgroup is the closure of a set of generators,
membership in the centralizer reduces to commuting with each generator. -/
lemma mem_centralizer_iff_closure (g : NQubitPauliGroupElement n) (S : StabilizerGroup n)
    (genSet : Set (NQubitPauliGroupElement n))
    (h_closure : S.toSubgroup = Subgroup.closure genSet) :
    g ∈ centralizer S ↔ ∀ s ∈ genSet, s * g = g * s := by
  rw [mem_centralizer_iff, h_closure]
  exact Subgroup.forall_comm_closure_iff g genSet

/-- Every element of a stabilizer group lies in its centralizer, because the
group is abelian. -/
theorem stabilizer_le_centralizer (S : StabilizerGroup n) :
    S.toSubgroup ≤ centralizer S :=
  fun g hg h hh => S.is_abelian h g hh hg

/-!
## Normalizer and centralizer coincide
-/

/-- The normalizer of `S` in the n-qubit Pauli group: the elements `g` whose
conjugation action maps `S` to itself. -/
noncomputable def pauliNormalizer (S : StabilizerGroup n) : Subgroup (NQubitPauliGroupElement n) :=
  Subgroup.normalizer S.toSubgroup

/-- The normalizer of a stabilizer group in the Pauli group equals its
centralizer: a normalizing element `g` that anticommuted with some `s ∈ S` would
give `g * s * g⁻¹ = -s ∈ S`, hence `-I ∈ S`. -/
theorem pauliNormalizer_eq_centralizer (S : StabilizerGroup n) :
    pauliNormalizer S = centralizer S := by
  refine le_antisymm (fun g hg s hs => ?_) (Subgroup.centralizer_le_normalizer _)
  rcases NQubitPauliGroupElement.commute_or_anticommute g s with h | h
  · exact h.symm
  · have h' : g * s = negIdentity n * (s * g) := h
    have h_mem := S.toSubgroup.mul_mem ((Subgroup.mem_normalizer_iff.mp hg s).1 hs)
      (S.toSubgroup.inv_mem hs)
    rw [h', show negIdentity n * (s * g) * g⁻¹ * s⁻¹ = negIdentity n by group] at h_mem
    exact absurd h_mem S.neg_identity_not_mem

/-!
## Excluding operators from the stabilizer

If `Q` commutes with the whole stabilizer and anticommutes with `P`, then `P`
cannot lie in the stabilizer. Taking `Q` to be a logical `Z` (respectively `X`)
shows that a logical `X` (respectively `Z`) is not a stabilizer.
-/

/-- If `P` and `Q` anticommute and `Q` commutes with every element of the
stabilizer, then `P` is not in the stabilizer group. -/
theorem not_mem_stabilizer_of_anticommutes_centralizer (S : StabilizerGroup n)
    (P Q : NQubitPauliGroupElement n) (hQ_cent : Q ∈ centralizer S)
    (h_anticomm : NQubitPauliGroupElement.Anticommute P Q) :
    P ∉ S.toSubgroup := by
  intro hP
  have h : P * Q = negIdentity n * (Q * P) := h_anticomm
  rw [← hQ_cent P hP] at h
  exact negIdentity_ne_one n (right_eq_mul.mp h)

end StabilizerGroup
end Quantum
