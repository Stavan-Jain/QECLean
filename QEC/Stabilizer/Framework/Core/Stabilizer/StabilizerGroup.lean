import Mathlib.LinearAlgebra.Matrix.Defs
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Data.Complex.Basic
import Mathlib.Tactic
import Mathlib.Algebra.Group.Defs
import Mathlib.Algebra.Group.Subgroup.Basic
import QEC.Foundations.Foundations
import QEC.Stabilizer.Foundations.PauliGroupSingle
import QEC.Stabilizer.Foundations.PauliGroup

/-!
# Stabilizer groups

A stabilizer group is an abelian subgroup of the n-qubit Pauli group that does
not contain `-I`. Its codespace is the set of states fixed by every element;
excluding `-I` is what keeps the codespace nonzero, since `-I` fixes no nonzero
vector.

Main definitions:

- `StabilizerGroup.negIdentity n`: the element `-I`;
- `StabilizerGroup n`: an abelian subgroup of the n-qubit Pauli group not
  containing `negIdentity n`;
- `StabilizerGroup.IsStabilizedVec g v`, `StabilizerGroup.IsStabilizedBy g ψ`:
  the vector `v` (the state `ψ`) is a `+1` eigenvector of the matrix of `g`;
- `StabilizerGroup.IsInCodespace ψ S`: the state `ψ` is stabilized by every
  element of `S`.

For example, the stabilizer group of the 3-qubit bit-flip repetition code is
generated by `Z₁Z₂` and `Z₂Z₃`, and its codespace is spanned by `|000⟩` and
`|111⟩`.
-/

namespace Quantum
open Matrix
open scoped BigOperators
open NQubitPauliGroupElement
open NQubitPauliOperator

variable {n : ℕ}

namespace StabilizerGroup

/-!
## The element `-I`
-/

/-- The negative identity `-I`: phase `-1` and the identity on every qubit. It
is `NQubitPauliGroupElement.minusOne n`, under the name used for stabilizer
groups. -/
def negIdentity (n : ℕ) : NQubitPauliGroupElement n :=
  NQubitPauliGroupElement.minusOne n

@[simp] lemma negIdentity_phasePower (n : ℕ) : (negIdentity n).phasePower = 2 := rfl

@[simp] lemma negIdentity_operators (n : ℕ) :
    (negIdentity n).operators = NQubitPauliOperator.identity n := rfl

/-- `negIdentity n` is `NQubitPauliGroupElement.minusOne n`. -/
lemma negIdentity_eq_minusOne (n : ℕ) :
    (negIdentity n : NQubitPauliGroupElement n) = NQubitPauliGroupElement.minusOne n := rfl

/-- The negative identity is not the group identity: their phases differ. -/
lemma negIdentity_ne_one (n : ℕ) : negIdentity n ≠ (1 : NQubitPauliGroupElement n) :=
  fun h => by simpa using congrArg phasePower h

/-!
## Stabilized vectors and states
-/

/-- The vector `v` is stabilized by the Pauli group element `g`: it is an
eigenvector of the matrix of `g` with eigenvalue `+1`. -/
def IsStabilizedVec (g : NQubitPauliGroupElement n) (v : NQubitVec n) : Prop :=
  Matrix.mulVec (g.toMatrix) v = v

/-- The quantum state `ψ` is stabilized by the Pauli group element `g`: its
underlying vector is. -/
def IsStabilizedBy (g : NQubitPauliGroupElement n) (ψ : NQubitState n) : Prop :=
  IsStabilizedVec g ψ.val

end StabilizerGroup

/-- A stabilizer group: an abelian subgroup of the n-qubit Pauli group that does
not contain `-I`. -/
structure StabilizerGroup (n : ℕ) where
  /-- The underlying subgroup of the n-qubit Pauli group. -/
  toSubgroup : Subgroup (NQubitPauliGroupElement n)
  /-- The subgroup is abelian: all elements commute. -/
  is_abelian : ∀ (g h : NQubitPauliGroupElement n) (_ : g ∈ toSubgroup) (_ : h ∈ toSubgroup),
    g * h = h * g
  /-- The stabilizer does not contain `-I`. -/
  no_neg_identity : StabilizerGroup.negIdentity n ∉ toSubgroup

namespace StabilizerGroup

/-- Coerce a stabilizer group to its underlying subgroup. -/
instance : Coe (StabilizerGroup n) (Subgroup (NQubitPauliGroupElement n)) :=
  ⟨StabilizerGroup.toSubgroup⟩

/-- The state `ψ` is in the codespace of the stabilizer group `S`: it is
stabilized by every element of `S`. -/
def IsInCodespace (ψ : NQubitState n) (S : StabilizerGroup n) : Prop :=
  ∀ g ∈ S.toSubgroup, IsStabilizedBy g ψ

/-!
## Subgroup properties
-/

/-- The identity element is in every stabilizer group. -/
lemma one_mem (S : StabilizerGroup n) : (1 : NQubitPauliGroupElement n) ∈ S.toSubgroup :=
  S.toSubgroup.one_mem

/-- A stabilizer group is closed under multiplication. -/
lemma mul_mem (S : StabilizerGroup n) {g h : NQubitPauliGroupElement n}
    (hg : g ∈ S.toSubgroup) (hh : h ∈ S.toSubgroup) : g * h ∈ S.toSubgroup :=
  S.toSubgroup.mul_mem hg hh

/-- A stabilizer group is closed under inverses. -/
lemma inv_mem (S : StabilizerGroup n) {g : NQubitPauliGroupElement n}
    (hg : g ∈ S.toSubgroup) : g⁻¹ ∈ S.toSubgroup :=
  S.toSubgroup.inv_mem hg

/-- All elements of a stabilizer group commute. -/
lemma commutes (S : StabilizerGroup n) {g h : NQubitPauliGroupElement n}
    (hg : g ∈ S.toSubgroup) (hh : h ∈ S.toSubgroup) : g * h = h * g :=
  S.is_abelian g h hg hh

/-- The negative identity is not in any stabilizer group. -/
lemma neg_identity_not_mem (S : StabilizerGroup n) : negIdentity n ∉ S.toSubgroup :=
  S.no_neg_identity

/-!
## The elements stabilizing a vector form a subgroup
-/

/-- The identity element stabilizes every vector. -/
lemma identity_stabilizes_vec (v : NQubitVec n) :
    IsStabilizedVec (1 : NQubitPauliGroupElement n) v := by
  rw [IsStabilizedVec, NQubitPauliGroupElement.toMatrix_one, one_mulVec]

/-- If `g` and `h` stabilize a vector, so does `g * h`. -/
lemma IsStabilizedVec.mul {g h : NQubitPauliGroupElement n} {v : NQubitVec n}
    (hg : IsStabilizedVec g v) (hh : IsStabilizedVec h v) : IsStabilizedVec (g * h) v := by
  unfold IsStabilizedVec at hg hh ⊢
  rw [toMatrix_mul, ← mulVec_mulVec, hh, hg]

/-- If `g` stabilizes a vector, so does `g⁻¹`. -/
lemma IsStabilizedVec.inv {g : NQubitPauliGroupElement n} {v : NQubitVec n}
    (hg : IsStabilizedVec g v) : IsStabilizedVec g⁻¹ v := by
  unfold IsStabilizedVec at hg ⊢
  conv_lhs => rw [← hg]
  rw [mulVec_mulVec, ← toMatrix_mul, inv_mul_cancel, toMatrix_one, one_mulVec]

/-- The identity element stabilizes every quantum state. -/
lemma identity_stabilizes (ψ : NQubitState n) : IsStabilizedBy (1 : NQubitPauliGroupElement n) ψ :=
  identity_stabilizes_vec ψ.val

/-- If `g` and `h` stabilize a state, so does `g * h`. -/
lemma IsStabilizedBy.mul {g h : NQubitPauliGroupElement n} {ψ : NQubitState n}
    (hg : IsStabilizedBy g ψ) (hh : IsStabilizedBy h ψ) : IsStabilizedBy (g * h) ψ :=
  IsStabilizedVec.mul hg hh

/-- If `g` stabilizes a state, so does `g⁻¹`. -/
lemma IsStabilizedBy.inv {g : NQubitPauliGroupElement n} {ψ : NQubitState n}
    (hg : IsStabilizedBy g ψ) : IsStabilizedBy g⁻¹ ψ :=
  IsStabilizedVec.inv hg

end StabilizerGroup

end Quantum
