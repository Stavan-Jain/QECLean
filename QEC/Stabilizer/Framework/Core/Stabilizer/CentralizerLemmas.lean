import Mathlib.Tactic
import QEC.Stabilizer.Framework.Core.Stabilizer.Centralizer
import QEC.Stabilizer.Framework.Symplectic.IndependentEquiv

/-!
# Centralizer membership from generators

Introduction forms of `StabilizerGroup.mem_centralizer_iff_closure`: an element
that commutes with every generator of a stabilizer group lies in its
centralizer, for a generating set (`mem_centralizer_of_commutes_genSet`) and
for a generator list (`mem_centralizer_of_commutes_list`).
-/

namespace Quantum
namespace StabilizerGroup
namespace CentralizerLemmas

open NQubitPauliGroupElement

variable {n : ℕ}

/-- If `S.toSubgroup = closure genSet` and `g` commutes with every element of
`genSet`, then `g` is in the centralizer of `S`. -/
lemma mem_centralizer_of_commutes_genSet
    (g : NQubitPauliGroupElement n) (S : StabilizerGroup n)
    (genSet : Set (NQubitPauliGroupElement n))
    (h_closure : S.toSubgroup = Subgroup.closure genSet)
    (h_comm : ∀ s ∈ genSet, s * g = g * s) :
    g ∈ centralizer S :=
  (mem_centralizer_iff_closure g S genSet h_closure).2 h_comm

/-- If `S.toSubgroup` is generated by the list `L` and `g` commutes with every
element of `L`, then `g` is in the centralizer of `S`. -/
lemma mem_centralizer_of_commutes_list
    (g : NQubitPauliGroupElement n) (S : StabilizerGroup n)
    (L : List (NQubitPauliGroupElement n))
    (h_closure : S.toSubgroup = Subgroup.closure (NQubitPauliGroupElement.listToSet L))
    (h_comm : ∀ s ∈ NQubitPauliGroupElement.listToSet L, s * g = g * s) :
    g ∈ centralizer S :=
  mem_centralizer_of_commutes_genSet g S _ h_closure h_comm

end CentralizerLemmas
end StabilizerGroup
end Quantum
