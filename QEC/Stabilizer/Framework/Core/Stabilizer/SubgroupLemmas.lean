import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.Tactic

/-!
# Subgroup lemmas for generated subgroups

Generic group-theoretic statements about `Subgroup.closure`, with no
Pauli-specific content, used to build stabilizer groups from generators:

- `Subgroup.mem_centralizer_closure_iff`, `Subgroup.forall_comm_closure_iff`:
  an element centralizes `closure S` iff it commutes with every element of `S`;
- `Subgroup.closure_commutes_of_commutes_generators`,
  `Subgroup.abelian_closure_of_pairwise_commute`: commutation lifts from
  generators to the subgroups they generate;
- `Subgroup.mem_closure_union_exists_mul_of_commute_generators`: if `S` and `T`
  commute elementwise, every element of `closure (S ∪ T)` is a product `z * x`
  with `z ∈ closure S` and `x ∈ closure T`;
- `Subgroup.IndependentGenerators`: no generator lies in the subgroup generated
  by the others.
-/

namespace Subgroup

variable {G : Type*} [Group G]

/-!
## Centralizer of a closure
-/

/-- An element lies in the centralizer of `closure S` iff it commutes with every
element of `S`. -/
theorem mem_centralizer_closure_iff (g : G) (S : Set G) :
    g ∈ Subgroup.centralizer (closure S : Set G) ↔ ∀ s ∈ S, s * g = g * s := by
  refine ⟨fun hg s hs => hg s (subset_closure hs), fun hg h hh => ?_⟩
  induction hh using closure_induction with
  | mem s hs => exact hg s hs
  | one => rw [one_mul, mul_one]
  | mul x y _ _ hx hy => rw [mul_assoc, hy, ← mul_assoc, hx, mul_assoc]
  | inv x _ hx =>
    rw [← mul_right_inj x, ← mul_assoc, mul_inv_cancel, one_mul, ← mul_assoc, hx, mul_assoc,
      mul_inv_cancel, mul_one]

/-- An element commutes with every element of `closure S` iff it commutes with
every element of `S`. -/
theorem forall_comm_closure_iff (g : G) (S : Set G) :
    (∀ h ∈ closure S, h * g = g * h) ↔ ∀ s ∈ S, s * g = g * s :=
  mem_centralizer_closure_iff g S

/-!
## Lifting commutation from generators to closures
-/

/-- If every element of `S` commutes with every element of `T`, then every
element of `closure S` commutes with every element of `closure T`. -/
theorem closure_commutes_of_commutes_generators {S T : Set G}
    (hST : ∀ s ∈ S, ∀ t ∈ T, s * t = t * s) :
    ∀ g ∈ closure S, ∀ k ∈ closure T, g * k = k * g := fun _ hg _ hk =>
  (((closure_le (centralizer (closure T : Set G))).2 fun s hs =>
    (mem_centralizer_closure_iff s T).2 fun t ht => (hST s hs t ht).symm) hg _ hk).symm

/-- If the elements of `S` commute pairwise, then the subgroup `closure S` is
abelian. -/
theorem abelian_closure_of_pairwise_commute (S : Set G)
    (hS : ∀ g ∈ S, ∀ h ∈ S, g * h = h * g) :
    ∀ g ∈ closure S, ∀ h ∈ closure S, g * h = h * g :=
  closure_commutes_of_commutes_generators hS

/-!
## Normal form in a commuting union
-/

/-- If every element of `S` commutes with every element of `T`, then every
element of `closure (S ∪ T)` can be written as `z * x` with `z ∈ closure S` and
`x ∈ closure T`. -/
theorem mem_closure_union_exists_mul_of_commute_generators {S T : Set G}
    (hST : ∀ s ∈ S, ∀ t ∈ T, s * t = t * s) :
    ∀ g, g ∈ closure (S ∪ T) → ∃ z ∈ closure S, ∃ x ∈ closure T, g = z * x := by
  have h_comm := closure_commutes_of_commutes_generators hST
  intro g hg
  induction hg using closure_induction with
  | mem y hy =>
    rcases hy with hy | hy
    · exact ⟨y, subset_closure hy, 1, one_mem _, (mul_one y).symm⟩
    · exact ⟨1, one_mem _, y, subset_closure hy, (one_mul y).symm⟩
  | one => exact ⟨1, one_mem _, 1, one_mem _, (mul_one 1).symm⟩
  | mul g₁ g₂ _ _ h₁ h₂ =>
    obtain ⟨z₁, hz₁, x₁, hx₁, rfl⟩ := h₁
    obtain ⟨z₂, hz₂, x₂, hx₂, rfl⟩ := h₂
    refine ⟨z₁ * z₂, mul_mem hz₁ hz₂, x₁ * x₂, mul_mem hx₁ hx₂, ?_⟩
    rw [mul_assoc, ← mul_assoc x₁, ← h_comm z₂ hz₂ x₁ hx₁, mul_assoc, mul_assoc]
  | inv g _ h =>
    obtain ⟨z, hz, x, hx, rfl⟩ := h
    exact ⟨z⁻¹, inv_mem hz, x⁻¹, inv_mem hx, by rw [h_comm z hz x hx, mul_inv_rev]⟩

/-!
## Independent generating sets
-/

/-- A set `S` is an independent generating set if no element of `S` lies in the
subgroup generated by the other elements of `S`. -/
def IndependentGenerators (S : Set G) : Prop :=
  ∀ g ∈ S, g ∉ closure (S \ {g})

end Subgroup
