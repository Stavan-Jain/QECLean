import Mathlib.Tactic
import QEC.Stabilizer.Framework.Core.Stabilizer.StabilizerGroup
import QEC.Stabilizer.Framework.Core.Stabilizer.SubgroupLemmas
import QEC.Stabilizer.Framework.Core.CSS.CSSPredicates

/-!
# CSS generators do not generate `-I`

`CSS.negIdentity_not_mem_closure_union`: a subgroup generated by Z-type
elements `ZGen` and X-type elements `XGen` that commute with each other does
not contain `negIdentity n`. This is the hypothesis `-I ∉ S` required of a
stabilizer group, for CSS-style generating sets.

The proof is algebraic. Since the two families commute, an element of
`Subgroup.closure (ZGen ∪ XGen)` is a product `z * x` with `z` in the closure
of `ZGen`, hence Z-type, and `x` in the closure of `XGen`, hence X-type
(`Subgroup.mem_closure_union_exists_mul_of_commute_generators`). If such a
product has identity operator part, then `z = x = 1`
(`NQubitPauliGroupElement.z_mul_x_eq_one_of_operators_eq_identity`); but
`negIdentity n` has identity operator part and is not `1`.
-/

namespace Quantum
namespace CSS

open StabilizerGroup NQubitPauliGroupElement

/-- If `ZGen` and `XGen` are phase-0 Z-type / X-type generators that commute
generatorwise, then `negIdentity n` is not in the subgroup they generate. -/
theorem negIdentity_not_mem_closure_union
    {n : ℕ} (ZGen XGen : Set (NQubitPauliGroupElement n))
    (hZ : ∀ z, z ∈ ZGen → NQubitPauliGroupElement.IsZTypeElement z)
    (hX : ∀ x, x ∈ XGen → NQubitPauliGroupElement.IsXTypeElement x)
    (hZX : ∀ z ∈ ZGen, ∀ x ∈ XGen, z * x = x * z) :
    negIdentity n ∉ Subgroup.closure (ZGen ∪ XGen) := by
  intro hneg
  obtain ⟨z, hz, x, hx, hzx⟩ :=
    Subgroup.mem_closure_union_exists_mul_of_commute_generators hZX (negIdentity n) hneg
  exact negIdentity_ne_one n <| hzx.trans <|
    z_mul_x_eq_one_of_operators_eq_identity z x (IsZTypeElement_of_mem_closure hZ z hz)
      (IsXTypeElement_of_mem_closure hX x hx) (hzx ▸ rfl)

end CSS
end Quantum
