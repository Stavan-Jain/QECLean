import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Tactic
import QEC.Stabilizer.Foundations.PauliGroup

/-!
# Z-type and X-type Pauli operators

The stabilizer generators of a CSS code are products of `Z`s only or of `X`s
only. This file provides the predicates describing such operators, at three
levels:

- `PauliOperator.IsZType` / `PauliOperator.IsXType`: a single-qubit Pauli is `I`
  or `Z` (respectively `I` or `X`);
- `NQubitPauliOperator.IsZType` / `NQubitPauliOperator.IsXType`: every tensor
  factor is Z-type (respectively X-type);
- `NQubitPauliGroupElement.IsZTypeElement` /
  `NQubitPauliGroupElement.IsXTypeElement`: the phase is `0` and the operator
  part is Z-type (respectively X-type).

Main results, in the namespace `NQubitPauliGroupElement`:

- `IsZTypeElement_of_mem_closure`, `IsXTypeElement_of_mem_closure`: typed
  elements are closed under the group operations, so a subgroup generated by
  Z-type (X-type) elements consists of Z-type (X-type) elements;
- `eq_one_of_IsZTypeElement_and_IsXTypeElement`: only the identity is both
  Z-type and X-type;
- `z_mul_x_eq_one_of_operators_eq_identity`: a product of a Z-type and an
  X-type element whose operator part is the identity is the identity.
-/

namespace Quantum

variable {n : ℕ}

namespace PauliOperator

/-- Z-type single-qubit Pauli: `I` or `Z`. -/
def IsZType (p : PauliOperator) : Prop :=
  p = PauliOperator.I ∨ p = PauliOperator.Z

/-- X-type single-qubit Pauli: `I` or `X`. -/
def IsXType (p : PauliOperator) : Prop :=
  p = PauliOperator.I ∨ p = PauliOperator.X

/-- The identity `I` is Z-type. -/
lemma IsZType_I : IsZType PauliOperator.I := Or.inl rfl

/-- The Pauli `Z` is Z-type. -/
lemma IsZType_Z : IsZType PauliOperator.Z := Or.inr rfl

/-- The identity `I` is X-type. -/
lemma IsXType_I : IsXType PauliOperator.I := Or.inl rfl

/-- The Pauli `X` is X-type. -/
lemma IsXType_X : IsXType PauliOperator.X := Or.inr rfl

/-- The only single-qubit Pauli that is both Z-type and X-type is `I`. -/
lemma eq_I_of_IsZType_and_IsXType {p : PauliOperator} (hz : IsZType p) (hx : IsXType p) :
    p = PauliOperator.I := by
  rcases hz with rfl | rfl
  · rfl
  · rcases hx with h | h <;> cases h

/-!
## Products of single-qubit Paulis of one type
-/

/-- Multiplying two Z-type single-qubit Paulis contributes no phase. -/
lemma mulOp_phasePower_zero_of_IsZType {p q : PauliOperator}
    (hp : IsZType p) (hq : IsZType q) :
    (p.mulOp q).phasePower = 0 := by
  rcases hp with rfl | rfl <;> rcases hq with rfl | rfl <;> rfl

/-- The product of two Z-type single-qubit Paulis is Z-type. -/
lemma mulOp_operator_IsZType_of_IsZType {p q : PauliOperator}
    (hp : IsZType p) (hq : IsZType q) :
    IsZType (p.mulOp q).operator := by
  rcases hp with rfl | rfl <;> rcases hq with rfl | rfl <;> simp [IsZType, mulOp]

/-- Multiplying two X-type single-qubit Paulis contributes no phase. -/
lemma mulOp_phasePower_zero_of_IsXType {p q : PauliOperator}
    (hp : IsXType p) (hq : IsXType q) :
    (p.mulOp q).phasePower = 0 := by
  rcases hp with rfl | rfl <;> rcases hq with rfl | rfl <;> rfl

/-- The product of two X-type single-qubit Paulis is X-type. -/
lemma mulOp_operator_IsXType_of_IsXType {p q : PauliOperator}
    (hp : IsXType p) (hq : IsXType q) :
    IsXType (p.mulOp q).operator := by
  rcases hp with rfl | rfl <;> rcases hq with rfl | rfl <;> simp [IsXType, mulOp]

/-- The product of a Z-type Pauli `p` and an X-type Pauli `q` is `I` (up to
phase) iff `p = I` and `q = I`: there is no cancellation across the two
types. -/
lemma mulOp_operator_eq_I_iff_of_types {p q : PauliOperator}
    (hp : IsZType p) (hq : IsXType q) :
    (p.mulOp q).operator = PauliOperator.I ↔ p = PauliOperator.I ∧ q = PauliOperator.I := by
  rcases hp with rfl | rfl <;> rcases hq with rfl | rfl <;> simp [mulOp]

end PauliOperator

namespace NQubitPauliOperator

/-- Z-type n-qubit Pauli operator: every component is `I` or `Z`. -/
def IsZType (op : NQubitPauliOperator n) : Prop :=
  ∀ i, PauliOperator.IsZType (op i)

/-- X-type n-qubit Pauli operator: every component is `I` or `X`. -/
def IsXType (op : NQubitPauliOperator n) : Prop :=
  ∀ i, PauliOperator.IsXType (op i)

/-- The n-qubit identity operator is Z-type. -/
lemma IsZType_identity : IsZType (NQubitPauliOperator.identity n) :=
  fun _ => PauliOperator.IsZType_I

/-- The n-qubit identity operator is X-type. -/
lemma IsXType_identity : IsXType (NQubitPauliOperator.identity n) :=
  fun _ => PauliOperator.IsXType_I

/-- If `p` is Z-type and `q` is X-type, the operator part of `mulOp p q` is the
identity iff both `p` and `q` are the identity. -/
lemma mulOp_operators_eq_identity_iff_of_types {p q : NQubitPauliOperator n}
    (hp : IsZType p) (hq : IsXType q) :
    (NQubitPauliGroupElement.mulOp p q).operators = NQubitPauliOperator.identity n ↔
      p = NQubitPauliOperator.identity n ∧ q = NQubitPauliOperator.identity n := by
  simp only [NQubitPauliOperator.ext_iff, ← forall_and]
  exact forall_congr' fun i => PauliOperator.mulOp_operator_eq_I_iff_of_types (hp i) (hq i)

end NQubitPauliOperator

namespace NQubitPauliGroupElement

/-!
## Typed group elements
-/

/-- Z-type group element: phase `0` and Z-type operator part. -/
def IsZTypeElement (g : NQubitPauliGroupElement n) : Prop :=
  g.phasePower = 0 ∧ NQubitPauliOperator.IsZType g.operators

/-- X-type group element: phase `0` and X-type operator part. -/
def IsXTypeElement (g : NQubitPauliGroupElement n) : Prop :=
  g.phasePower = 0 ∧ NQubitPauliOperator.IsXType g.operators

/-- The product `mulOp p q` of two Z-type n-qubit operators has phase `0`. -/
lemma mulOp_phasePower_zero_of_IsZType {p q : NQubitPauliOperator n}
    (hp : NQubitPauliOperator.IsZType p) (hq : NQubitPauliOperator.IsZType q) :
    (mulOp p q).phasePower = 0 :=
  Finset.sum_eq_zero (s := Finset.univ) fun i _ =>
    PauliOperator.mulOp_phasePower_zero_of_IsZType (hp i) (hq i)

/-- The product `mulOp p q` of two Z-type n-qubit operators has a Z-type
operator part. -/
lemma mulOp_operators_IsZType_of_IsZType {p q : NQubitPauliOperator n}
    (hp : NQubitPauliOperator.IsZType p) (hq : NQubitPauliOperator.IsZType q) :
    NQubitPauliOperator.IsZType (mulOp p q).operators :=
  fun i => PauliOperator.mulOp_operator_IsZType_of_IsZType (hp i) (hq i)

/-- The product `mulOp p q` of two X-type n-qubit operators has phase `0`. -/
lemma mulOp_phasePower_zero_of_IsXType {p q : NQubitPauliOperator n}
    (hp : NQubitPauliOperator.IsXType p) (hq : NQubitPauliOperator.IsXType q) :
    (mulOp p q).phasePower = 0 :=
  Finset.sum_eq_zero (s := Finset.univ) fun i _ =>
    PauliOperator.mulOp_phasePower_zero_of_IsXType (hp i) (hq i)

/-- The product `mulOp p q` of two X-type n-qubit operators has an X-type
operator part. -/
lemma mulOp_operators_IsXType_of_IsXType {p q : NQubitPauliOperator n}
    (hp : NQubitPauliOperator.IsXType p) (hq : NQubitPauliOperator.IsXType q) :
    NQubitPauliOperator.IsXType (mulOp p q).operators :=
  fun i => PauliOperator.mulOp_operator_IsXType_of_IsXType (hp i) (hq i)

/-!
## Closure under the group operations
-/

/-- The identity element is Z-type. -/
lemma IsZTypeElement_one : IsZTypeElement (1 : NQubitPauliGroupElement n) :=
  ⟨rfl, NQubitPauliOperator.IsZType_identity⟩

/-- The identity element is X-type. -/
lemma IsXTypeElement_one : IsXTypeElement (1 : NQubitPauliGroupElement n) :=
  ⟨rfl, NQubitPauliOperator.IsXType_identity⟩

/-- Z-type elements are closed under multiplication. -/
lemma IsZTypeElement_mul {g h : NQubitPauliGroupElement n}
    (hg : IsZTypeElement g) (hh : IsZTypeElement h) :
    IsZTypeElement (g * h) :=
  ⟨by simp [mul, hg.1, hh.1, mulOp_phasePower_zero_of_IsZType hg.2 hh.2],
    mulOp_operators_IsZType_of_IsZType hg.2 hh.2⟩

/-- X-type elements are closed under multiplication. -/
lemma IsXTypeElement_mul {g h : NQubitPauliGroupElement n}
    (hg : IsXTypeElement g) (hh : IsXTypeElement h) :
    IsXTypeElement (g * h) :=
  ⟨by simp [mul, hg.1, hh.1, mulOp_phasePower_zero_of_IsXType hg.2 hh.2],
    mulOp_operators_IsXType_of_IsXType hg.2 hh.2⟩

/-- Z-type elements are closed under inversion. -/
lemma IsZTypeElement_inv {g : NQubitPauliGroupElement n} (hg : IsZTypeElement g) :
    IsZTypeElement g⁻¹ :=
  ⟨by simp [inv, hg.1], hg.2⟩

/-- X-type elements are closed under inversion. -/
lemma IsXTypeElement_inv {g : NQubitPauliGroupElement n} (hg : IsXTypeElement g) :
    IsXTypeElement g⁻¹ :=
  ⟨by simp [inv, hg.1], hg.2⟩

/-- If every generator in `S` is Z-type, then every element of
`Subgroup.closure S` is Z-type. -/
theorem IsZTypeElement_of_mem_closure {S : Set (NQubitPauliGroupElement n)}
    (hS : ∀ g, g ∈ S → IsZTypeElement g) :
    ∀ g, g ∈ Subgroup.closure S → IsZTypeElement g := fun _ hg =>
  Subgroup.closure_induction (p := fun g _ => IsZTypeElement g) hS IsZTypeElement_one
    (fun _ _ _ _ => IsZTypeElement_mul) (fun _ _ => IsZTypeElement_inv) hg

/-- If every generator in `S` is X-type, then every element of
`Subgroup.closure S` is X-type. -/
theorem IsXTypeElement_of_mem_closure {S : Set (NQubitPauliGroupElement n)}
    (hS : ∀ g, g ∈ S → IsXTypeElement g) :
    ∀ g, g ∈ Subgroup.closure S → IsXTypeElement g := fun _ hg =>
  Subgroup.closure_induction (p := fun g _ => IsXTypeElement g) hS IsXTypeElement_one
    (fun _ _ _ _ => IsXTypeElement_mul) (fun _ _ => IsXTypeElement_inv) hg

/-!
## Elements of both types
-/

/-- The only n-qubit Pauli group element that is both Z-type and X-type is the
identity. In particular, a nontrivial X-type element is not in a subgroup
generated by Z-type elements, and vice versa. -/
theorem eq_one_of_IsZTypeElement_and_IsXTypeElement {g : NQubitPauliGroupElement n}
    (hz : IsZTypeElement g) (hx : IsXTypeElement g) : g = 1 :=
  NQubitPauliGroupElement.ext g 1 hz.1
    (funext fun i => PauliOperator.eq_I_of_IsZType_and_IsXType (hz.2 i) (hx.2 i))

/-- If `z` is Z-type, `x` is X-type and the operator part of `z * x` is the
identity, then `z * x = 1`: both factors are the identity. This is what keeps
`-I` out of a subgroup generated by Z-type and X-type elements. -/
lemma z_mul_x_eq_one_of_operators_eq_identity (z x : NQubitPauliGroupElement n)
    (hz : IsZTypeElement z) (hx : IsXTypeElement x)
    (h_op : (z * x).operators = NQubitPauliOperator.identity n) :
    z * x = 1 := by
  obtain ⟨hz1, hx1⟩ :=
    (NQubitPauliOperator.mulOp_operators_eq_identity_iff_of_types hz.2 hx.2).1 h_op
  rw [NQubitPauliGroupElement.ext z 1 hz.1 hz1, NQubitPauliGroupElement.ext x 1 hx.1 hx1, mul_one]

end NQubitPauliGroupElement

end Quantum
