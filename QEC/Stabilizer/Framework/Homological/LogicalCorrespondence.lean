import QEC.Stabilizer.Framework.Homological.StabGroup
import QEC.Stabilizer.Framework.Core.Logical.LogicalOperators

/-!
# Logical operators of a homological CSS code and homology

For a `HomologicalCode X` with stabilizer group `homologicalStabilizerGroup X`,
the chain operators are logical exactly on (dual) cycles and trivial exactly on
(dual) boundaries.

X side, for the chain complex itself:

* `chainXOperator_mem_centralizer_iff_mem_cycles`: `chainXOperator c` commutes
  with the stabilizer group iff `c` is a cycle
  (`chainXOperator_mem_centralizer_iff_of_toSubgroup_eq` for a stabilizer group
  given by another generating set);
* `chainXOperator_mem_XClosure_iff_mem_boundaries`: `chainXOperator c` is a
  product of X-checks iff `c` is a boundary;
* `chainXOperator_isNontrivialLogical_iff`: `chainXOperator c` is a nontrivial
  logical operator iff `c` is a cycle that is not a boundary.

Z side, for the dual complex (`dualCycles = ker dualBoundary`,
`dualBoundaries = range cutMap`):

* `chainZOperator_mem_centralizer_iff_mem_dualCycles`
  (`chainZOperator_mem_centralizer_iff_of_toSubgroup_eq`),
  `chainZOperator_mem_ZClosure_iff_mem_dualBoundaries` and
  `chainZOperator_isNontrivialLogical_iff`.

Both sides use the CSS decomposition of a stabilizer element as a product of a
Z-type and an X-type element: a stabilizer element with X-type operator part is
a product of X-checks (`xType_in_stabilizer_implies_in_XClosure`), and likewise
for Z (`zType_in_stabilizer_implies_in_ZClosure`).
-/

namespace Quantum
namespace Stabilizer
namespace Homological

open scoped BigOperators
open NQubitPauliGroupElement (IsXTypeElement IsZTypeElement IsXTypeElement_of_mem_closure
  IsZTypeElement_of_mem_closure)

/-- For a map `φ` from `𝔽₂`-coordinate vectors to a group that turns sums into
products, the subgroup generated by the images of the basis vectors
`Pi.single a 1` is the image of `φ`. -/
private lemma mem_closure_range_single_iff {G A : Type*} [Group G] [Finite A]
    [DecidableEq A] (φ : (A → ZMod 2) → G) (h0 : φ 0 = 1)
    (hadd : ∀ s t, φ (s + t) = φ s * φ t) (g : G) :
    g ∈ Subgroup.closure (Set.range fun a => φ (Pi.single a 1)) ↔ ∃ s, φ s = g := by
  refine ⟨fun hg => ?_, ?_⟩
  · induction hg using Subgroup.closure_induction with
    | mem y hy =>
      obtain ⟨a, rfl⟩ := hy
      exact ⟨_, rfl⟩
    | one => exact ⟨0, h0⟩
    | mul y z _ _ hy hz =>
      obtain ⟨s, rfl⟩ := hy
      obtain ⟨t, rfl⟩ := hz
      exact ⟨s + t, hadd s t⟩
    | inv y _ hy =>
      obtain ⟨s, rfl⟩ := hy
      have hss : s + s = 0 := funext fun a => CharTwo.add_self_eq_zero (s a)
      exact ⟨s, (inv_eq_of_mul_eq_one_right (by rw [← hadd, hss, h0])).symm⟩
  · rintro ⟨s, rfl⟩
    have hs : s ∈ Submodule.span (ZMod 2) (Set.range (Pi.basisFun (ZMod 2) A)) := by
      rw [(Pi.basisFun (ZMod 2) A).span_eq]
      exact Submodule.mem_top
    induction hs using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      exact Subgroup.subset_closure ⟨a, by rw [Pi.basisFun_apply]⟩
    | zero => exact h0 ▸ one_mem _
    | add x y _ _ hx hy => exact hadd x y ▸ mul_mem hx hy
    | smul a x _ hx =>
      obtain rfl | rfl := zmod2_eq_zero_or_eq_one a
      · rw [zero_smul, h0]
        exact one_mem _
      · rwa [one_smul]

/-- If the product of a Z-type and an X-type single-qubit Pauli is X-type, the
Z-type factor is `I`. -/
private lemma eq_I_of_mulOp_isXType {p q : PauliOperator} (hp : p.IsZType) (hq : q.IsXType)
    (h : (p.mulOp q).operator.IsXType) : p = PauliOperator.I := by
  rcases hp with rfl | rfl <;> rcases hq with rfl | rfl <;>
    simp_all [PauliOperator.IsXType, PauliOperator.mulOp]

/-- If the product of a Z-type and an X-type single-qubit Pauli is Z-type, the
X-type factor is `I`. -/
private lemma eq_I_of_mulOp_isZType {p q : PauliOperator} (hp : p.IsZType) (hq : q.IsXType)
    (h : (p.mulOp q).operator.IsZType) : q = PauliOperator.I := by
  rcases hp with rfl | rfl <;> rcases hq with rfl | rfl <;>
    simp_all [PauliOperator.IsZType, PauliOperator.mulOp]

namespace HomologicalCode

variable {X : HomologicalCode}

/-! ## X side: centralizer membership and cycles -/

/-- `chainXOperator c` commutes with the Z-check at `v` iff `(∂₁ c) v = 0`. -/
theorem chainXOperator_commutes_vertexStabOf_iff
    (c : X.C1 → ZMod 2) (v : X.C0) :
    X.chainXOperator c * X.vertexStabOf v = X.vertexStabOf v * X.chainXOperator c
    ↔ X.boundary1 c v = 0 := by
  rw [vertexStabOf, chainXOperator_commutes_chainZOperator_iff,
    chainInnerProduct_cutMap_singleVtx_eq_boundary1]

/-- `chainXOperator c` commutes with every Z generator iff `c` is a cycle. -/
theorem chainXOperator_commutes_ZGenerators_iff_mem_cycles (c : X.C1 → ZMod 2) :
    (∀ z ∈ X.ZGenerators, z * X.chainXOperator c = X.chainXOperator c * z)
    ↔ c ∈ X.cycles := by
  rw [mem_cycles_iff, funext_iff, ZGenerators, Set.forall_mem_range]
  exact forall_congr' fun v => eq_comm.trans (chainXOperator_commutes_vertexStabOf_iff c v)

/-- An X-chain operator commutes with every X-check, both being X-type. -/
lemma chainXOperator_commutes_faceStabOf
    (c : X.C1 → ZMod 2) (f : X.C2) :
    X.faceStabOf f * X.chainXOperator c = X.chainXOperator c * X.faceStabOf f :=
  (faceStabOf_isXType f).commute (chainXOperator_isXType c)

/-- `chainXOperator c` commutes with the stabilizer group iff `c` is a
cycle. -/
lemma chainXOperator_mem_centralizer_iff_mem_cycles
    (c : X.C1 → ZMod 2) :
    X.chainXOperator c ∈ Quantum.StabilizerGroup.centralizer X.homologicalStabilizerGroup
    ↔ c ∈ X.cycles := by
  rw [StabilizerGroup.mem_centralizer_iff_closure _ _ X.homologicalGenerators rfl,
    ← chainXOperator_commutes_ZGenerators_iff_mem_cycles]
  refine ⟨fun h z hz => h z (Or.inl hz), fun h s hs => ?_⟩
  rcases hs with hz | hx
  · exact h s hz
  · exact (XGenerators_isXType s hx).commute (chainXOperator_isXType c)

/-- `chainXOperator c` commutes with a stabilizer group `S` whose subgroup is
that of the homological stabilizer group iff `c` is a cycle. -/
lemma chainXOperator_mem_centralizer_iff_of_toSubgroup_eq
    {S : StabilizerGroup X.numQubits}
    (hS : S.toSubgroup = X.homologicalStabilizerGroup.toSubgroup) (c : X.C1 → ZMod 2) :
    X.chainXOperator c ∈ StabilizerGroup.centralizer S ↔ c ∈ X.cycles := by
  rw [StabilizerGroup.centralizer_eq_of_toSubgroup_eq _ _ hS]
  exact chainXOperator_mem_centralizer_iff_mem_cycles c

/-! ## X side: products of X-checks and boundaries -/

/-- `chainXOperator c` is a product of X-checks iff `c` is a boundary. -/
theorem chainXOperator_mem_XClosure_iff_mem_boundaries (c : X.C1 → ZMod 2) :
    X.chainXOperator c ∈ Subgroup.closure X.XGenerators ↔ c ∈ X.boundaries :=
  (mem_closure_range_single_iff (fun f => X.chainXOperator (X.boundary2 f)) (by simp)
    (fun s t => by simp only [map_add, chainXOperator_add]) _).trans
    (exists_congr fun _ => chainXOperator_injective.eq_iff)

/-- CSS decomposition: an element of the stabilizer group whose operator part
is X-type is a product of X-checks. -/
lemma xType_in_stabilizer_implies_in_XClosure
    (g : NQubitPauliGroupElement X.numQubits)
    (hg : g ∈ X.homologicalStabilizerGroup.toSubgroup)
    (hxt : NQubitPauliOperator.IsXType g.operators) :
    g ∈ Subgroup.closure X.XGenerators := by
  obtain ⟨z, hz, x, hx, rfl⟩ :=
    Subgroup.mem_closure_union_exists_mul_of_commute_generators
      ZGenerators_commute_XGenerators g hg
  have hzt := IsZTypeElement_of_mem_closure ZGenerators_isZType z hz
  have hxt' := IsXTypeElement_of_mem_closure XGenerators_isXType x hx
  have hz1 : z = 1 := NQubitPauliGroupElement.ext z 1 hzt.1
    (funext fun i => eq_I_of_mulOp_isXType (hzt.2 i) (hxt'.2 i) (hxt i))
  rwa [hz1, one_mul]

/-- If a stabilizer element has the operator part of `chainXOperator c`, then
`c` is a boundary. -/
lemma stabilizer_same_ops_implies_boundary
    (c : X.C1 → ZMod 2)
    (s : NQubitPauliGroupElement X.numQubits)
    (hs : s ∈ X.homologicalStabilizerGroup.toSubgroup)
    (heq : s.operators = (X.chainXOperator c).operators) :
    c ∈ X.boundaries := by
  have hcl := xType_in_stabilizer_implies_in_XClosure s hs
    (heq ▸ (chainXOperator_isXType c).2)
  have hph := (IsXTypeElement_of_mem_closure XGenerators_isXType s hcl).1
  rwa [NQubitPauliGroupElement.ext s _ hph heq,
    chainXOperator_mem_XClosure_iff_mem_boundaries] at hcl

/-- `chainXOperator c` is a nontrivial logical operator iff `c` is a cycle that
is not a boundary. -/
theorem chainXOperator_isNontrivialLogical_iff (c : X.C1 → ZMod 2) :
    Quantum.StabilizerGroup.IsNontrivialLogicalOperator
        (X.chainXOperator c) X.homologicalStabilizerGroup ↔
      c ∈ X.cycles ∧ c ∉ X.boundaries := by
  rw [Quantum.StabilizerGroup.IsNontrivialLogicalOperator_iff,
    chainXOperator_mem_centralizer_iff_mem_cycles]
  exact and_congr_right fun _ =>
    ⟨fun h hb => h _ (X.closure_XGenerators_le
      ((chainXOperator_mem_XClosure_iff_mem_boundaries c).2 hb)) rfl,
    fun hnb s hs heq => hnb (stabilizer_same_ops_implies_boundary c s hs heq)⟩

/-! ## Z side: centralizer membership and dual cycles

The Z side is the X side for the dual complex: the Z-checks are the chain
operators of the cuts `cutMap δ_v`, so cycles are replaced by
`dualCycles = ker dualBoundary` and boundaries by
`dualBoundaries = range cutMap`. -/

/-- `chainZOperator c` commutes with the X-check at `f` iff
`(dualBoundary c) f = 0`. -/
theorem chainZOperator_commutes_faceStabOf_iff
    (c : X.C1 → ZMod 2) (f : X.C2) :
    X.chainZOperator c * X.faceStabOf f = X.faceStabOf f * X.chainZOperator c
    ↔ X.dualBoundary c f = 0 := by
  rw [faceStabOf, eq_comm, chainXOperator_commutes_chainZOperator_iff,
    chainInnerProduct_boundary2_singleFace_eq_dualBoundary]

/-- `chainZOperator c` commutes with every X generator iff `c` is a dual
cycle. -/
theorem chainZOperator_commutes_XGenerators_iff_mem_dualCycles (c : X.C1 → ZMod 2) :
    (∀ x ∈ X.XGenerators, x * X.chainZOperator c = X.chainZOperator c * x)
    ↔ c ∈ X.dualCycles := by
  rw [dualCycles, LinearMap.mem_ker, funext_iff, XGenerators, Set.forall_mem_range]
  exact forall_congr' fun f => eq_comm.trans (chainZOperator_commutes_faceStabOf_iff c f)

/-- A Z-chain operator commutes with every Z-check, both being Z-type. -/
lemma chainZOperator_commutes_vertexStabOf
    (c : X.C1 → ZMod 2) (v : X.C0) :
    X.vertexStabOf v * X.chainZOperator c = X.chainZOperator c * X.vertexStabOf v :=
  (vertexStabOf_isZType v).commute (chainZOperator_isZType c)

/-- `chainZOperator c` commutes with the stabilizer group iff `c` is a dual
cycle. -/
lemma chainZOperator_mem_centralizer_iff_mem_dualCycles
    (c : X.C1 → ZMod 2) :
    X.chainZOperator c ∈ Quantum.StabilizerGroup.centralizer X.homologicalStabilizerGroup
    ↔ c ∈ X.dualCycles := by
  rw [StabilizerGroup.mem_centralizer_iff_closure _ _ X.homologicalGenerators rfl,
    ← chainZOperator_commutes_XGenerators_iff_mem_dualCycles]
  refine ⟨fun h x hx => h x (Or.inr hx), fun h s hs => ?_⟩
  rcases hs with hz | hx
  · exact (ZGenerators_isZType s hz).commute (chainZOperator_isZType c)
  · exact h s hx

/-- `chainZOperator c` commutes with a stabilizer group `S` whose subgroup is
that of the homological stabilizer group iff `c` is a dual cycle. -/
lemma chainZOperator_mem_centralizer_iff_of_toSubgroup_eq
    {S : StabilizerGroup X.numQubits}
    (hS : S.toSubgroup = X.homologicalStabilizerGroup.toSubgroup) (c : X.C1 → ZMod 2) :
    X.chainZOperator c ∈ StabilizerGroup.centralizer S ↔ c ∈ X.dualCycles := by
  rw [StabilizerGroup.centralizer_eq_of_toSubgroup_eq _ _ hS]
  exact chainZOperator_mem_centralizer_iff_mem_dualCycles c

/-! ## Z side: products of Z-checks and dual boundaries -/

/-- `chainZOperator c` is a product of Z-checks iff `c` is a dual boundary. -/
theorem chainZOperator_mem_ZClosure_iff_mem_dualBoundaries (c : X.C1 → ZMod 2) :
    X.chainZOperator c ∈ Subgroup.closure X.ZGenerators ↔ c ∈ X.dualBoundaries :=
  (mem_closure_range_single_iff (fun s => X.chainZOperator (X.cutMap s)) (by simp)
    (fun s t => by simp only [map_add, chainZOperator_add]) _).trans
    (exists_congr fun _ => chainZOperator_injective.eq_iff)

/-- CSS decomposition: an element of the stabilizer group whose operator part
is Z-type is a product of Z-checks. -/
lemma zType_in_stabilizer_implies_in_ZClosure
    (g : NQubitPauliGroupElement X.numQubits)
    (hg : g ∈ X.homologicalStabilizerGroup.toSubgroup)
    (hzt : NQubitPauliOperator.IsZType g.operators) :
    g ∈ Subgroup.closure X.ZGenerators := by
  obtain ⟨z, hz, x, hx, rfl⟩ :=
    Subgroup.mem_closure_union_exists_mul_of_commute_generators
      ZGenerators_commute_XGenerators g hg
  have hzt' := IsZTypeElement_of_mem_closure ZGenerators_isZType z hz
  have hxt := IsXTypeElement_of_mem_closure XGenerators_isXType x hx
  have hx1 : x = 1 := NQubitPauliGroupElement.ext x 1 hxt.1
    (funext fun i => eq_I_of_mulOp_isZType (hzt'.2 i) (hxt.2 i) (hzt i))
  rwa [hx1, mul_one]

/-- If a stabilizer element has the operator part of `chainZOperator c`, then
`c` is a dual boundary. -/
lemma stabilizer_same_ops_implies_dualBoundary
    (c : X.C1 → ZMod 2)
    (s : NQubitPauliGroupElement X.numQubits)
    (hs : s ∈ X.homologicalStabilizerGroup.toSubgroup)
    (heq : s.operators = (X.chainZOperator c).operators) :
    c ∈ X.dualBoundaries := by
  have hcl := zType_in_stabilizer_implies_in_ZClosure s hs
    (heq ▸ (chainZOperator_isZType c).2)
  have hph := (IsZTypeElement_of_mem_closure ZGenerators_isZType s hcl).1
  rwa [NQubitPauliGroupElement.ext s _ hph heq,
    chainZOperator_mem_ZClosure_iff_mem_dualBoundaries] at hcl

/-- `chainZOperator c` is a nontrivial logical operator iff `c` is a dual
cycle that is not a dual boundary. -/
theorem chainZOperator_isNontrivialLogical_iff (c : X.C1 → ZMod 2) :
    Quantum.StabilizerGroup.IsNontrivialLogicalOperator
        (X.chainZOperator c) X.homologicalStabilizerGroup ↔
      c ∈ X.dualCycles ∧ c ∉ X.dualBoundaries := by
  rw [Quantum.StabilizerGroup.IsNontrivialLogicalOperator_iff,
    chainZOperator_mem_centralizer_iff_mem_dualCycles]
  exact and_congr_right fun _ =>
    ⟨fun h hb => h _ (X.closure_ZGenerators_le
      ((chainZOperator_mem_ZClosure_iff_mem_dualBoundaries c).2 hb)) rfl,
    fun hnb s hs heq => hnb (stabilizer_same_ops_implies_dualBoundary c s hs heq)⟩

end HomologicalCode

end Homological
end Stabilizer
end Quantum
