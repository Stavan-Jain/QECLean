import Mathlib.LinearAlgebra.Matrix.Rank
import QEC.Stabilizer.Framework.Homological.StabGroup
import QEC.Stabilizer.Framework.Homological.Presentation
import QEC.Stabilizer.Framework.Symplectic.SymplecticImage

/-!
# The stabilizer code of a homological code, without hypotheses

`HomologicalCode.presentation` (`Presentation.lean`) turns a homological code
into a `StabilizerCode` only when the face-boundary map and the vertex cut map
are injective, so that the canonical checks are independent and can be counted.
For most codes of interest they are not: on the toric code all faces together
have empty boundary, so one face check is a product of the others, and likewise
for the vertices.

This file gives the construction that needs no such hypothesis:

```
HomologicalCode.toStabilizerCode (X : HomologicalCode) :
    StabilizerCode X.numQubits (Module.finrank (ZMod 2) X.H1)
```

Its stabilizer group is `X.homologicalStabilizerGroup`, the closure of all face
and vertex checks, and the number of logical qubits is `dim H₁` with no
counting of generators at all.

## The rank argument

`StabilizerGroup.card_eq_two_pow_finrank` says that any stabilizer group `S`
has `2 ^ dim (sympImage S)` elements, where `sympImage S` is the `𝔽₂`-span
of the symplectic vectors of its elements. The work is therefore to compute
the rank of the symplectic image of the closure of the checks:

- **closure vs. span**
  (`StabilizerGroup.sympImage_eq_span_of_toSubgroup_eq_closure`): the
  symplectic image of `Subgroup.closure G` is the span of the symplectic
  vectors of `G` itself, since the symplectic map turns products into sums.
  No independence of `G` is needed — this is where the generic construction
  departs from `card_closure_eq_two_pow_length`, which counts an independent
  list.
- **the two blocks** (`span_image_XGenerators`, `span_image_ZGenerators`):
  the symplectic vector of a face check `chainXOperator (∂₂ δ_f)` is
  `∂₂ δ_f` placed in the X block, and that of a vertex check is `cutMap δ_v`
  placed in the Z block. The block embeddings `sympEmbX`, `sympEmbZ` are
  injective linear maps, and the vectors `δ_f` span the chain space, so the
  X-check span is the image of `range ∂₂` and the Z-check span is the image
  of `range cutMap`.
- **the blocks are independent**
  (`finrank_sympImage_homologicalStabilizerGroup`): a vector in both blocks
  is zero, so the rank of the whole symplectic image is
  `dim (range ∂₂) + dim (range cutMap)`.
- **transposes have equal rank** (`finrank_range_cutMap`): `cutMap` is the
  transpose of `∂₁` (`cutMap_apply`), so `Matrix.rank_transpose` gives
  `dim (range cutMap) = dim (range ∂₁)`.
- **rank-nullity** (`finrank_sympImage_eq_numQubits_sub_finrank_H1`):
  `dim (range ∂₁) = n - dim Z₁` and `dim H₁ = dim Z₁ - dim B₁`, so the rank
  is `dim B₁ + n - dim Z₁ = n - dim H₁`.

The toric instance is in `Codes/Toric/HomologicalToCode.lean`, where the
construction is matched against the hand-trimmed `toricStabilizerCode`.
-/

namespace Quantum

open NQubitPauliGroupElement NQubitPauliOperator

namespace StabilizerGroup

variable {n : ℕ}

/-- The symplectic image of a stabilizer group generated by `G` is the span of
the symplectic vectors of `G`: the symplectic map sends products to sums, so
the closure adds nothing to the span (`toSymplectic_mem_span_of_mem_closure`),
and `G` sits inside its own closure. -/
lemma sympImage_eq_span_of_toSubgroup_eq_closure (S : StabilizerGroup n)
    (G : Set (NQubitPauliGroupElement n)) (h : S.toSubgroup = Subgroup.closure G) :
    S.sympImage =
      Submodule.span (ZMod 2)
        ((fun g : NQubitPauliGroupElement n => toSymplectic g.operators) '' G) := by
  apply le_antisymm
  · rw [sympImage, Submodule.span_le]
    rintro _ ⟨g, hg, rfl⟩
    rw [h] at hg
    exact Quantum.toSymplectic_mem_span_of_mem_closure hg
  · apply Submodule.span_mono
    rintro _ ⟨g, hg, rfl⟩
    exact ⟨g, h ▸ Subgroup.subset_closure hg, rfl⟩

/-- **Size of a stabilizer group from its generators.** A stabilizer group
generated by `G` has `2 ^ r` elements, where `r` is the `𝔽₂`-rank of the
span of the symplectic vectors of `G`. The generators need not be
independent. -/
theorem card_eq_two_pow_finrank_span_of_toSubgroup_eq_closure (S : StabilizerGroup n)
    (G : Set (NQubitPauliGroupElement n)) (h : S.toSubgroup = Subgroup.closure G) :
    Nat.card S.toSubgroup =
      2 ^ Module.finrank (ZMod 2) (Submodule.span (ZMod 2)
        ((fun g : NQubitPauliGroupElement n => toSymplectic g.operators) '' G)) := by
  rw [card_eq_two_pow_finrank, sympImage_eq_span_of_toSubgroup_eq_closure S G h]

/-- **Size of the closure of commuting generators.** Pairwise commuting
generators whose closure avoids `−I` generate a group with `2 ^ r` elements,
`r` the rank of the span of their symplectic vectors. This is the set-level,
hypothesis-free form of `card_closure_eq_two_pow_length`, which asks for an
independent list and gets `r = L.length`. -/
theorem card_closure_eq_two_pow_finrank_span (G : Set (NQubitPauliGroupElement n))
    (hC : ∀ g ∈ G, ∀ h ∈ G, g * h = h * g)
    (hN : negIdentity n ∉ Subgroup.closure G) :
    Nat.card (Subgroup.closure G) =
      2 ^ Module.finrank (ZMod 2) (Submodule.span (ZMod 2)
        ((fun g : NQubitPauliGroupElement n => toSymplectic g.operators) '' G)) :=
  card_eq_two_pow_finrank_span_of_toSubgroup_eq_closure
    ⟨Subgroup.closure G,
      fun g h hg hh => Subgroup.abelian_closure_of_pairwise_commute G hC g hg h hh, hN⟩
    G rfl

end StabilizerGroup

namespace Stabilizer.Homological.HomologicalCode

open scoped BigOperators

variable (X : HomologicalCode)

/-! ### The X and Z block embeddings -/

/-- Place a 1-chain in the X block of a symplectic vector (zero Z block). -/
noncomputable def sympEmbX :
    (X.C1 → ZMod 2) →ₗ[ZMod 2] (Fin (X.numQubits + X.numQubits) → ZMod 2) where
  toFun c := Fin.append (fun q => c (X.edgeEquiv.symm q)) 0
  map_add' c c' := by
    funext j
    refine Fin.addCases (fun q => ?_) (fun q => ?_) j <;>
      simp only [Pi.add_apply, Pi.zero_apply, Fin.append_left, Fin.append_right, add_zero]
  map_smul' a c := by
    funext j
    refine Fin.addCases (fun q => ?_) (fun q => ?_) j <;>
      simp only [RingHom.id_apply, Pi.smul_apply, Pi.zero_apply, Fin.append_left,
        Fin.append_right, smul_zero]

/-- Place a 1-chain in the Z block of a symplectic vector (zero X block). -/
noncomputable def sympEmbZ :
    (X.C1 → ZMod 2) →ₗ[ZMod 2] (Fin (X.numQubits + X.numQubits) → ZMod 2) where
  toFun c := Fin.append 0 (fun q => c (X.edgeEquiv.symm q))
  map_add' c c' := by
    funext j
    refine Fin.addCases (fun q => ?_) (fun q => ?_) j <;>
      simp only [Pi.add_apply, Pi.zero_apply, Fin.append_left, Fin.append_right, add_zero]
  map_smul' a c := by
    funext j
    refine Fin.addCases (fun q => ?_) (fun q => ?_) j <;>
      simp only [RingHom.id_apply, Pi.smul_apply, Pi.zero_apply, Fin.append_left,
        Fin.append_right, smul_zero]

theorem sympEmbX_apply (c : X.C1 → ZMod 2) :
    X.sympEmbX c = Fin.append (fun q => c (X.edgeEquiv.symm q)) 0 :=
  rfl

theorem sympEmbZ_apply (c : X.C1 → ZMod 2) :
    X.sympEmbZ c = Fin.append 0 (fun q => c (X.edgeEquiv.symm q)) :=
  rfl

theorem sympEmbX_castAdd (c : X.C1 → ZMod 2) (q : Fin X.numQubits) :
    X.sympEmbX c (Fin.castAdd X.numQubits q) = c (X.edgeEquiv.symm q) := by
  rw [sympEmbX_apply, Fin.append_left]

theorem sympEmbX_natAdd (c : X.C1 → ZMod 2) (q : Fin X.numQubits) :
    X.sympEmbX c (Fin.natAdd X.numQubits q) = 0 := by
  rw [sympEmbX_apply, Fin.append_right, Pi.zero_apply]

theorem sympEmbZ_castAdd (c : X.C1 → ZMod 2) (q : Fin X.numQubits) :
    X.sympEmbZ c (Fin.castAdd X.numQubits q) = 0 := by
  rw [sympEmbZ_apply, Fin.append_left, Pi.zero_apply]

theorem sympEmbZ_natAdd (c : X.C1 → ZMod 2) (q : Fin X.numQubits) :
    X.sympEmbZ c (Fin.natAdd X.numQubits q) = c (X.edgeEquiv.symm q) := by
  rw [sympEmbZ_apply, Fin.append_right]

/-- The symplectic vector of an encoded X-chain is the chain in the X block. -/
theorem toSymplectic_chainXOperator (c : X.C1 → ZMod 2) :
    toSymplectic (X.chainXOperator c).operators = X.sympEmbX c := by
  funext j
  refine Fin.addCases (fun q => ?_) (fun q => ?_) j
  · have h := X.toSymplectic_chainXOperator_X c (X.edgeEquiv.symm q)
    rw [Equiv.apply_symm_apply] at h
    rw [h, sympEmbX_castAdd]
  · rw [toSymplectic_chainXOperator_Z, sympEmbX_natAdd]

/-- The symplectic vector of an encoded Z-chain is the chain in the Z block. -/
theorem toSymplectic_chainZOperator (c : X.C1 → ZMod 2) :
    toSymplectic (X.chainZOperator c).operators = X.sympEmbZ c := by
  funext j
  refine Fin.addCases (fun q => ?_) (fun q => ?_) j
  · rw [toSymplectic_chainZOperator_X, sympEmbZ_castAdd]
  · have h := X.toSymplectic_chainZOperator_Z c (X.edgeEquiv.symm q)
    rw [Equiv.apply_symm_apply] at h
    rw [h, sympEmbZ_natAdd]

/-- The X block embedding is injective. -/
theorem sympEmbX_injective : Function.Injective X.sympEmbX := by
  intro c c' h
  funext e
  have := congr_fun h (Fin.castAdd X.numQubits (X.edgeEquiv e))
  rwa [sympEmbX_castAdd, sympEmbX_castAdd, Equiv.symm_apply_apply] at this

/-- The Z block embedding is injective. -/
theorem sympEmbZ_injective : Function.Injective X.sympEmbZ := by
  intro c c' h
  funext e
  have := congr_fun h (Fin.natAdd X.numQubits (X.edgeEquiv e))
  rwa [sympEmbZ_natAdd, sympEmbZ_natAdd, Equiv.symm_apply_apply] at this

/-- The X and Z blocks meet only in `0`. -/
theorem disjoint_map_sympEmbX_map_sympEmbZ
    (A B : Submodule (ZMod 2) (X.C1 → ZMod 2)) :
    Disjoint (A.map X.sympEmbX) (B.map X.sympEmbZ) := by
  rw [Submodule.disjoint_def]
  rintro _ ⟨a, _, rfl⟩ ⟨b, _, hb⟩
  funext j
  refine Fin.addCases (fun q => ?_) (fun q => ?_) j
  · rw [← hb, sympEmbZ_castAdd, Pi.zero_apply]
  · rw [sympEmbX_natAdd, Pi.zero_apply]

/-! ### The symplectic spans of the face and vertex checks -/

/-- The symplectic vectors of the face checks span the X-block image of
`range ∂₂`: the face check at `f` encodes `∂₂ δ_f`, and the `δ_f` span
the 2-chains. -/
theorem span_image_XGenerators :
    Submodule.span (ZMod 2)
        ((fun g : NQubitPauliGroupElement X.numQubits => toSymplectic g.operators) ''
          X.XGenerators) =
      (LinearMap.range X.boundary2).map X.sympEmbX := by
  have himg : (fun g : NQubitPauliGroupElement X.numQubits => toSymplectic g.operators) ''
      X.XGenerators =
      X.sympEmbX '' (X.boundary2 '' Set.range (Pi.basisFun (ZMod 2) X.C2)) := by
    ext v
    simp only [XGenerators, faceStabOf, singleFace, Set.image_image, Set.mem_image,
      Set.mem_range, exists_exists_eq_and, toSymplectic_chainXOperator, Pi.basisFun_apply]
  rw [himg, ← Submodule.map_span, ← Submodule.map_span, (Pi.basisFun (ZMod 2) X.C2).span_eq,
    Submodule.map_top]

/-- The symplectic vectors of the vertex checks span the Z-block image of
`range cutMap`: the vertex check at `v` encodes `cutMap δ_v`, and the `δ_v`
span the 0-chains. -/
theorem span_image_ZGenerators :
    Submodule.span (ZMod 2)
        ((fun g : NQubitPauliGroupElement X.numQubits => toSymplectic g.operators) ''
          X.ZGenerators) =
      (LinearMap.range X.cutMap).map X.sympEmbZ := by
  have himg : (fun g : NQubitPauliGroupElement X.numQubits => toSymplectic g.operators) ''
      X.ZGenerators =
      X.sympEmbZ '' (X.cutMap '' Set.range (Pi.basisFun (ZMod 2) X.C0)) := by
    ext v
    simp only [ZGenerators, vertexStabOf, singleVtx, Set.image_image, Set.mem_image,
      Set.mem_range, exists_exists_eq_and, toSymplectic_chainZOperator, Pi.basisFun_apply]
  rw [himg, ← Submodule.map_span, ← Submodule.map_span, (Pi.basisFun (ZMod 2) X.C0).span_eq,
    Submodule.map_top]

/-- The symplectic image of the homological stabilizer group is the direct
sum of the X-block image of `range ∂₂` and the Z-block image of
`range cutMap`. -/
theorem sympImage_homologicalStabilizerGroup :
    X.homologicalStabilizerGroup.sympImage =
      (LinearMap.range X.boundary2).map X.sympEmbX ⊔
        (LinearMap.range X.cutMap).map X.sympEmbZ := by
  rw [StabilizerGroup.sympImage_eq_span_of_toSubgroup_eq_closure _ X.homologicalGenerators rfl,
    homologicalGenerators, Set.image_union, Submodule.span_union, span_image_XGenerators,
    span_image_ZGenerators, sup_comm]

/-- The rank of the symplectic image of the homological stabilizer group is
`rank ∂₂ + rank cutMap`: the two blocks are independent, and the block
embeddings are injective. -/
theorem finrank_sympImage_homologicalStabilizerGroup :
    Module.finrank (ZMod 2) X.homologicalStabilizerGroup.sympImage =
      Module.finrank (ZMod 2) (LinearMap.range X.boundary2) +
        Module.finrank (ZMod 2) (LinearMap.range X.cutMap) := by
  rw [sympImage_homologicalStabilizerGroup]
  have hsum := Submodule.finrank_sup_add_finrank_inf_eq
    ((LinearMap.range X.boundary2).map X.sympEmbX) ((LinearMap.range X.cutMap).map X.sympEmbZ)
  rw [disjoint_iff.mp (X.disjoint_map_sympEmbX_map_sympEmbZ _ _), finrank_bot, add_zero] at hsum
  rw [hsum, ← (Submodule.equivMapOfInjective _ X.sympEmbX_injective _).finrank_eq,
    ← (Submodule.equivMapOfInjective _ X.sympEmbZ_injective _).finrank_eq]

/-! ### The rank of the cut map -/

/-- The rank of a linear map between coordinate spaces is the rank of its
matrix in the standard bases. -/
private theorem finrank_range_eq_rank_toMatrix' {A B : Type} [Fintype A] [DecidableEq A]
    [Finite B] (T : (A → ZMod 2) →ₗ[ZMod 2] (B → ZMod 2)) :
    Module.finrank (ZMod 2) (LinearMap.range T) = (LinearMap.toMatrix' T).rank := by
  rw [Matrix.rank_eq_finrank_range_toLin (LinearMap.toMatrix' T) (Pi.basisFun (ZMod 2) B)
    (Pi.basisFun (ZMod 2) A), Matrix.toLin_eq_toLin', Matrix.toLin'_toMatrix']

/-- The matrix of `cutMap` is the transpose of the matrix of `∂₁`. -/
theorem toMatrix'_cutMap :
    LinearMap.toMatrix' X.cutMap = (LinearMap.toMatrix' X.boundary1).transpose := by
  ext e v
  simp [LinearMap.toMatrix'_apply, Pi.single_apply]

/-- `cutMap` and `∂₁` are transposes, so they have the same rank. -/
theorem finrank_range_cutMap :
    Module.finrank (ZMod 2) (LinearMap.range X.cutMap) =
      Module.finrank (ZMod 2) (LinearMap.range X.boundary1) := by
  rw [finrank_range_eq_rank_toMatrix', finrank_range_eq_rank_toMatrix', toMatrix'_cutMap,
    Matrix.rank_transpose]

/-! ### Assembly -/

/-- The rank of the symplectic image of the homological stabilizer group is
`n − dim H₁`: by `finrank_sympImage_homologicalStabilizerGroup` and
`finrank_range_cutMap` it is `dim B₁ + rank ∂₁`, rank-nullity gives
`rank ∂₁ = n − dim Z₁`, and `dim H₁ = dim Z₁ − dim B₁`. -/
theorem finrank_sympImage_eq_numQubits_sub_finrank_H1 :
    Module.finrank (ZMod 2) X.homologicalStabilizerGroup.sympImage =
      X.numQubits - Module.finrank (ZMod 2) X.H1 := by
  rw [finrank_sympImage_homologicalStabilizerGroup, finrank_range_cutMap,
    X.finrank_H1_eq_cycles_sub_boundaries]
  have hrn := X.rank_nullity_boundary1
  have hC1 := X.finrank_C1
  have hn := X.numQubits_eq
  have hle : Module.finrank (ZMod 2) X.boundaries ≤ Module.finrank (ZMod 2) X.cycles :=
    Submodule.finrank_mono X.boundaries_le_cycles
  change Module.finrank (ZMod 2) X.boundaries + _ = _
  omega

/-- `dim H₁ ≤ n`: `H₁` is a quotient of the cycle space, a subspace of the
`n`-dimensional chain space. -/
theorem finrank_H1_le_numQubits : Module.finrank (ZMod 2) X.H1 ≤ X.numQubits := by
  rw [X.finrank_H1_eq_cycles_sub_boundaries]
  have hle : Module.finrank (ZMod 2) X.cycles ≤ Module.finrank (ZMod 2) (X.C1 → ZMod 2) :=
    Submodule.finrank_le X.cycles
  have hC1 := X.finrank_C1
  have hn := X.numQubits_eq
  omega

/-- **The stabilizer code of a homological code.** Its stabilizer group is the
closure of all face and vertex checks, and it encodes `dim H₁` logical qubits.
No hypothesis on the chain complex is needed: the size of the group is computed
from the rank of its symplectic image
(`finrank_sympImage_eq_numQubits_sub_finrank_H1`) rather than by counting
independent generators. -/
noncomputable def toStabilizerCode :
    StabilizerGroup.StabilizerCode X.numQubits (Module.finrank (ZMod 2) X.H1) where
  toStabilizerGroup := X.homologicalStabilizerGroup
  hk := X.finrank_H1_le_numQubits
  card_eq := by
    rw [StabilizerGroup.card_eq_two_pow_finrank, finrank_sympImage_eq_numQubits_sub_finrank_H1]

/-- The stabilizer group of `toStabilizerCode` is the homological stabilizer
group. -/
@[simp] theorem toStabilizerCode_toStabilizerGroup :
    X.toStabilizerCode.toStabilizerGroup = X.homologicalStabilizerGroup :=
  rfl

/-- The stabilizer subgroup of `toStabilizerCode` is the closure of the face
and vertex checks. -/
@[simp] theorem toStabilizerCode_toSubgroup :
    X.toStabilizerCode.toStabilizerGroup.toSubgroup = Subgroup.closure X.homologicalGenerators :=
  rfl

/-- `toStabilizerCode` agrees with the hypothesis-laden `presentation` whenever
the latter applies: both have the closure of the checks as stabilizer group. -/
theorem toStabilizerCode_toSubgroup_eq_presentation (k : ℕ) (hk : k ≤ X.numQubits)
    (hcard : Fintype.card X.C0 + Fintype.card X.C2 = X.numQubits - k)
    (hcut : Function.Injective X.cutMap) (hboundary : Function.Injective X.boundary2) :
    X.toStabilizerCode.toStabilizerGroup.toSubgroup =
      (X.presentation k hk hcard hcut hboundary).toCode.toStabilizerGroup.toSubgroup :=
  (X.presentation_toCode_subgroup k hk hcard hcut hboundary).symm

/-- When `presentation` applies, its `k` is `dim H₁`: the two codes have the
same stabilizer subgroup, and `k` is determined by the subgroup. -/
theorem finrank_H1_eq_of_presentation (k : ℕ) (hk : k ≤ X.numQubits)
    (hcard : Fintype.card X.C0 + Fintype.card X.C2 = X.numQubits - k)
    (hcut : Function.Injective X.cutMap) (hboundary : Function.Injective X.boundary2) :
    Module.finrank (ZMod 2) X.H1 = k :=
  StabilizerGroup.StabilizerCode.k_eq_of_toSubgroup_eq X.toStabilizerCode
    (X.presentation k hk hcard hcut hboundary).toCode
    (X.toStabilizerCode_toSubgroup_eq_presentation k hk hcard hcut hboundary)

end Stabilizer.Homological.HomologicalCode

end Quantum
