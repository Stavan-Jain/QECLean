import QEC.Stabilizer.Framework.Homological.Presentation
import QEC.Stabilizer.Framework.Homological.LogicalCorrespondence

/-!
# Trimming the checks of a homological code

`trimChecks X v f` is the homological code with the qubits of `X` that keeps
only the Z-checks selected by `v : V → X.C0` and the X-checks selected by
`f : F → X.C2`. Its boundary maps are those of `X`, restricted to the selected
0-cells and extended from the selected 2-cells by `checkExtension`.

If every Z-check and every X-check of `X` is generated by the selected ones,
nothing is lost:

* `trimChecks_boundaries_eq`, `trimChecks_cycles_eq`: the boundaries and the
  cycles are those of `X`;
* `trimChecks_stabilizer_eq`: the stabilizer subgroup is that of `X`.

This is how a code with dependent checks is given an independent list of
checks, as `HomologicalCode.presentation` requires.
-/

namespace Quantum.Stabilizer.Homological.HomologicalCode
open scoped BigOperators

/-- Extend a coefficient vector on a selection `e : ι → κ` to all of `κ`:
`c ↦ ∑ i, c i • δ_(e i)`. -/
def checkExtension {ι κ : Type} [Fintype ι] [DecidableEq κ] (e : ι → κ) :
    (ι → ZMod 2) →ₗ[ZMod 2] (κ → ZMod 2) where
  toFun c := ∑ i, c i • Pi.single (e i) 1
  map_add' a b := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' a c := by simp [Finset.smul_sum, smul_smul]

/-- The extension of the point mass at `i` is the point mass at `e i`. -/
theorem checkExtension_single {ι κ : Type} [Fintype ι] [DecidableEq ι] [DecidableEq κ]
    (e : ι → κ) (i : ι) : checkExtension e (Pi.single i 1) = Pi.single (e i) 1 := by
  simp [checkExtension, Pi.single_apply]

/-- The homological code with the qubits of `X` that keeps only the Z-checks
selected by `v` and the X-checks selected by `f`. -/
noncomputable def trimChecks (X : HomologicalCode)
    {V F : Type} [Fintype V] [DecidableEq V] [Fintype F] [DecidableEq F]
    (v : V → X.C0) (f : F → X.C2) : HomologicalCode where
  C0 := V
  C1 := X.C1
  C2 := F
  decEq0 := inferInstance
  decEq1 := inferInstance
  decEq2 := inferInstance
  fin0 := inferInstance
  fin1 := inferInstance
  fin2 := inferInstance
  boundary1 := (LinearMap.funLeft (ZMod 2) (ZMod 2) v).comp X.boundary1
  boundary2 := X.boundary2.comp (checkExtension f)
  boundary_comp := LinearMap.ext fun c => funext fun q =>
    congrFun (X.boundary_comp_apply (checkExtension f c)) (v q)
  numQubits := X.numQubits
  numQubits_eq := X.numQubits_eq
  edgeEquiv := X.edgeEquiv

variable (X : HomologicalCode)
variable {V F : Type} [Fintype V] [DecidableEq V] [Fintype F] [DecidableEq F]
variable (v : V → X.C0) (f : F → X.C2)

/-- The boundary of a selected face is its boundary in `X`. -/
theorem trimChecks_boundary2_single (i : F) :
    (X.trimChecks v f).boundary2 (Pi.single i 1) = X.boundary2 (Pi.single (f i) 1) :=
  congrArg X.boundary2 (checkExtension_single f i)

/-- The cut map of the trimmed code is the cut map of `X` on the extension of
the coefficients to all vertices. -/
theorem trimChecks_cutMap (s : V → ZMod 2) :
    (X.trimChecks v f).cutMap s = X.cutMap (checkExtension v s) := by
  ext q
  change (∑ i : V, s i * X.boundary1 (Pi.single q 1) (v i)) = _
  simp only [checkExtension, LinearMap.coe_mk, AddHom.coe_mk, map_sum, map_smul,
    Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  exact Finset.sum_congr rfl fun i _ => by simp [Pi.single_apply]

/-- The cut of a selected vertex is its cut in `X`. -/
theorem trimChecks_cutMap_single (i : V) :
    (X.trimChecks v f).cutMap (Pi.single i 1) = X.cutMap (Pi.single (v i) 1) :=
  (trimChecks_cutMap X v f _).trans (congrArg X.cutMap (checkExtension_single v i))

/-- Trimming keeps the boundaries if the boundary of every face of `X` is a
boundary of the trimmed code. -/
theorem trimChecks_boundaries_eq
    (h : ∀ i : X.C2, X.boundary2 (Pi.single i 1) ∈ (X.trimChecks v f).boundaries) :
    (X.trimChecks v f).boundaries = X.boundaries := by
  refine le_antisymm ?_ ?_
  · rintro c ⟨s, rfl⟩
    exact ⟨checkExtension f s, rfl⟩
  · change LinearMap.range X.boundary2 ≤ _
    rw [← Submodule.map_top, ← (Pi.basisFun (ZMod 2) X.C2).span_eq, Submodule.map_span,
      Submodule.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    simpa using h i

/-- Trimming keeps the cycles if the cut of every vertex of `X` is a cut of
the trimmed code. -/
theorem trimChecks_cycles_eq
    (h : ∀ i : X.C0, X.cutMap (Pi.single i 1) ∈
      LinearMap.range (X.trimChecks v f).cutMap) :
    (X.trimChecks v f).cycles = X.cycles := by
  ext c
  refine ⟨fun hc => (mem_cycles_iff _ _).2 (funext fun i => ?_), fun hc =>
    (mem_cycles_iff _ _).2 (funext fun i => congrFun ((mem_cycles_iff _ _).1 hc) (v i))⟩
  obtain ⟨s, hs⟩ := h i
  have hp := (X.trimChecks v f).boundary1_cutMap_transpose c s
  rw [(mem_cycles_iff _ _).1 hc, hs] at hp
  have hx := X.boundary1_cutMap_transpose c (Pi.single i 1)
  simp at hp hx
  simpa [Pi.single_apply] using hx.trans hp.symm

/-- Trimming keeps the stabilizer subgroup if every Z-check and every X-check
of `X` is generated by the selected ones. -/
theorem trimChecks_stabilizer_eq
    (hV : ∀ i : X.C0, X.cutMap (Pi.single i 1) ∈
      LinearMap.range (X.trimChecks v f).cutMap)
    (hF : ∀ i : X.C2, X.boundary2 (Pi.single i 1) ∈
      (X.trimChecks v f).boundaries) :
    (X.trimChecks v f).homologicalStabilizerGroup.toSubgroup =
      X.homologicalStabilizerGroup.toSubgroup := by
  change Subgroup.closure (X.trimChecks v f).homologicalGenerators =
    Subgroup.closure X.homologicalGenerators
  apply le_antisymm
  · refine (Subgroup.closure_le _).mpr ?_
    rintro g (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · change (X.trimChecks v f).chainZOperator
        ((X.trimChecks v f).cutMap (Pi.single i 1)) ∈ _
      rw [trimChecks_cutMap_single]
      exact Subgroup.subset_closure (Or.inl ⟨v i, rfl⟩)
    · change (X.trimChecks v f).chainXOperator
        ((X.trimChecks v f).boundary2 (Pi.single i 1)) ∈ _
      rw [trimChecks_boundary2_single]
      exact Subgroup.subset_closure (Or.inr ⟨f i, rfl⟩)
  · refine (Subgroup.closure_le _).mpr ?_
    rintro g (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · exact (X.trimChecks v f).closure_ZGenerators_le
        (((X.trimChecks v f).chainZOperator_mem_ZClosure_iff_mem_dualBoundaries _).mpr (hV i))
    · exact (X.trimChecks v f).closure_XGenerators_le
        (((X.trimChecks v f).chainXOperator_mem_XClosure_iff_mem_boundaries _).mpr (hF i))

end Quantum.Stabilizer.Homological.HomologicalCode
