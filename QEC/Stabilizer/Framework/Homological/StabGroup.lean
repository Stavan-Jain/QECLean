import QEC.Stabilizer.Framework.Homological.Generators
import QEC.Stabilizer.Framework.Core.Stabilizer.SubgroupLemmas
import QEC.Stabilizer.Framework.Core.Stabilizer.StabilizerGroup
import QEC.Stabilizer.Framework.Core.CSS.CSSNoNegI

/-!
# The CSS stabilizer group of a homological code

`homologicalStabilizerGroup X : StabilizerGroup X.numQubits` is the subgroup
generated by `homologicalGenerators X`, the union of the Z-checks and the
X-checks of `X`. The generators pairwise commute
(`homologicalGenerators_commute`) and, being a commuting family of Z-type and
X-type elements, do not generate `-I`
(`negIdentity_not_mem_closure_homologicalGenerators`).

No independence of the checks is assumed here. Packaging the group as a
`StabilizerCode` is done in `Homological.Presentation` (independent checks) and
`Homological.ToCode` (in general).
-/

namespace Quantum
namespace Stabilizer
namespace Homological

open scoped BigOperators

namespace HomologicalCode

variable (X : HomologicalCode)

/-- The generator set of the CSS code: all Z-checks and all X-checks. -/
noncomputable def homologicalGenerators :
    Set (NQubitPauliGroupElement X.numQubits) :=
  X.ZGenerators ∪ X.XGenerators

variable {X}

/-- The Z generators are among the generators. -/
lemma ZGenerators_subset_homologicalGenerators :
    X.ZGenerators ⊆ X.homologicalGenerators :=
  Set.subset_union_left

/-- The X generators are among the generators. -/
lemma XGenerators_subset_homologicalGenerators :
    X.XGenerators ⊆ X.homologicalGenerators :=
  Set.subset_union_right

/-- All generators pairwise commute: two checks of the same type always do,
and a Z-check commutes with an X-check by the chain-complex law. -/
lemma homologicalGenerators_commute :
    ∀ g ∈ X.homologicalGenerators, ∀ h ∈ X.homologicalGenerators, g * h = h * g := by
  rintro g (hg | hg) h (hh | hh)
  · exact (ZGenerators_isZType _ hg).commute (ZGenerators_isZType _ hh)
  · exact ZGenerators_commute_XGenerators _ hg _ hh
  · exact (ZGenerators_commute_XGenerators _ hh _ hg).symm
  · exact (XGenerators_isXType _ hg).commute (XGenerators_isXType _ hh)

variable (X)

/-- The subgroup generated by the checks does not contain `-I`. -/
lemma negIdentity_not_mem_closure_homologicalGenerators :
    Quantum.StabilizerGroup.negIdentity X.numQubits ∉
      Subgroup.closure X.homologicalGenerators :=
  Quantum.CSS.negIdentity_not_mem_closure_union X.ZGenerators X.XGenerators
    ZGenerators_isZType XGenerators_isXType ZGenerators_commute_XGenerators

/-- The CSS stabilizer group of a homological code: the subgroup generated by
its Z-checks and X-checks. -/
noncomputable def homologicalStabilizerGroup :
    Quantum.StabilizerGroup X.numQubits where
  toSubgroup := Subgroup.closure X.homologicalGenerators
  is_abelian := fun g h hg hh =>
    Subgroup.abelian_closure_of_pairwise_commute X.homologicalGenerators
      homologicalGenerators_commute g hg h hh
  no_neg_identity := negIdentity_not_mem_closure_homologicalGenerators X

/-- The stabilizer subgroup is the closure of the generator set. -/
@[simp] lemma homologicalStabilizerGroup_toSubgroup :
    (X.homologicalStabilizerGroup).toSubgroup =
      Subgroup.closure X.homologicalGenerators := rfl

/-- The subgroup generated by the Z-checks lies in the stabilizer group. -/
lemma closure_ZGenerators_le :
    Subgroup.closure X.ZGenerators ≤ X.homologicalStabilizerGroup.toSubgroup :=
  Subgroup.closure_mono ZGenerators_subset_homologicalGenerators

/-- The subgroup generated by the X-checks lies in the stabilizer group. -/
lemma closure_XGenerators_le :
    Subgroup.closure X.XGenerators ≤ X.homologicalStabilizerGroup.toSubgroup :=
  Subgroup.closure_mono XGenerators_subset_homologicalGenerators

end HomologicalCode

end Homological
end Stabilizer
end Quantum
