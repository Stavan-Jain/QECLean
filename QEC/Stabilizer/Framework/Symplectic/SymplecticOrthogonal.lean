/-!
# The symplectic form and symplectic orthogonals

`symplecticBilinear v w` is the symplectic form on `Fin (n + n) → ZMod 2`: it
pairs the `X`-half of each vector with the `Z`-half of the other. On symplectic
vectors of Pauli operators it is the symplectic inner product
(`symplecticBilinear_toSymplectic`), so two Pauli group elements commute iff
their symplectic vectors are orthogonal
(`symplecticBilinear_toSymplectic_eq_zero_iff`).

- `sympBilinForm n` is the form as a `LinearMap.BilinForm`; it is reflexive
  (`sympBilinForm_isRefl`) and nondegenerate (`sympBilinForm_nondegenerate`).
- `sympOrthogonal W` is the orthogonal of a submodule `W`, with
  `mem_sympOrthogonal_span_iff` and `sympOrthogonal_sup`.
- `mem_of_mem_sympOrthogonal_of_pair`: if `V` is isotropic of dimension `n - 1`
  and `x`, `z` are orthogonal to `V` with `symplecticBilinear x z = 1`, then
  every vector orthogonal to `V`, `x` and `z` lies in `V`.
- `mem_sympOrthogonal_sympSpan_iff`: an operator commutes with every element of
  a list `L` iff its symplectic vector is orthogonal to `sympSpan L`.
- `rowsLinearIndependent_append_pair`: adjoining to a list with linearly
  independent rows an anticommuting pair of elements that commute with the
  list keeps the rows linearly independent.
- `no_weight_w_logical_of_centralizer_in_span`: if every weight-`w` operator
  commuting with all elements of `L` has its symplectic vector in `sympSpan L`,
  then the stabilizer group generated by `L` has no nontrivial logical operator
  of weight `w`.
-/

namespace Quantum

variable {n : ℕ}

namespace NQubitPauliOperator

open Submodule Module

/-! ## The symplectic form on vectors -/

/-- The symplectic bilinear form on `Fin (n + n) → ZMod 2`: the `X`-half of
each vector is paired with the `Z`-half of the other. -/
def symplecticBilinear (v w : Fin (n + n) → ZMod 2) : ZMod 2 :=
  (Finset.univ : Finset (Fin n)).sum (fun i =>
    v (Fin.castAdd n i) * w (Fin.natAdd n i) + v (Fin.natAdd n i) * w (Fin.castAdd n i))

/-- On symplectic vectors of Pauli operators, the symplectic form is the
symplectic inner product of the operators. -/
theorem symplecticBilinear_toSymplectic (op₁ op₂ : NQubitPauliOperator n) :
    symplecticBilinear (toSymplectic op₁) (toSymplectic op₂) = symplecticInner op₁ op₂ := by
  simp only [symplecticBilinear, toSymplectic_X_part, toSymplectic_Z_part]
  rfl

/-- Two Pauli group elements commute iff their symplectic vectors are
orthogonal for the symplectic form. -/
lemma symplecticBilinear_toSymplectic_eq_zero_iff (p q : NQubitPauliGroupElement n) :
    symplecticBilinear (toSymplectic p.operators) (toSymplectic q.operators) = 0 ↔
      p * q = q * p := by
  rw [symplecticBilinear_toSymplectic, commutes_iff_symplectic_inner_zero]

/-- The symplectic form is symmetric. -/
lemma symplecticBilinear_comm (v w : Fin (n + n) → ZMod 2) :
    symplecticBilinear v w = symplecticBilinear w v :=
  Finset.sum_congr rfl fun i _ => by ring

/-- The symplectic form is alternating: every vector is orthogonal to itself. -/
lemma symplecticBilinear_self (v : Fin (n + n) → ZMod 2) : symplecticBilinear v v = 0 :=
  Finset.sum_eq_zero fun i _ => by rw [mul_comm, CharTwo.add_self_eq_zero]

/-- The symplectic form is additive in the first argument. -/
lemma symplecticBilinear_add_left (v₁ v₂ w : Fin (n + n) → ZMod 2) :
    symplecticBilinear (v₁ + v₂) w = symplecticBilinear v₁ w + symplecticBilinear v₂ w := by
  rw [symplecticBilinear, symplecticBilinear, symplecticBilinear, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun i _ => by simp only [Pi.add_apply]; ring

/-- The symplectic form is homogeneous in the first argument. -/
lemma symplecticBilinear_smul_left (c : ZMod 2) (v w : Fin (n + n) → ZMod 2) :
    symplecticBilinear (c • v) w = c * symplecticBilinear v w := by
  rw [symplecticBilinear, symplecticBilinear, Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by simp only [Pi.smul_apply, smul_eq_mul]; ring

/-- The symplectic form is additive in the second argument. -/
lemma symplecticBilinear_add_right (v w₁ w₂ : Fin (n + n) → ZMod 2) :
    symplecticBilinear v (w₁ + w₂) = symplecticBilinear v w₁ + symplecticBilinear v w₂ := by
  simp only [symplecticBilinear_comm v, symplecticBilinear_add_left]

/-- The symplectic form is homogeneous in the second argument. -/
lemma symplecticBilinear_smul_right (c : ZMod 2) (v w : Fin (n + n) → ZMod 2) :
    symplecticBilinear v (c • w) = c * symplecticBilinear v w := by
  simp only [symplecticBilinear_comm v, symplecticBilinear_smul_left]

/-- An `X`-position of `Fin (n + n)` is never a `Z`-position. -/
private lemma castAdd_ne_natAdd (i k : Fin n) : Fin.castAdd n i ≠ Fin.natAdd n k := by
  simp only [ne_eq, Fin.ext_iff, Fin.val_castAdd, Fin.val_natAdd]
  omega

/-- Pairing with the basis vector at the `Z`-position of qubit `i` reads off the
`X`-coordinate of qubit `i`. -/
lemma symplecticBilinear_single_natAdd (v : Fin (n + n) → ZMod 2) (i : Fin n) :
    symplecticBilinear v (Pi.single (Fin.natAdd n i) 1) = v (Fin.castAdd n i) := by
  simp [symplecticBilinear, Pi.single_apply, castAdd_ne_natAdd, -Fin.natAdd_eq_addNat]

/-- Pairing with the basis vector at the `X`-position of qubit `i` reads off the
`Z`-coordinate of qubit `i`. -/
lemma symplecticBilinear_single_castAdd (v : Fin (n + n) → ZMod 2) (i : Fin n) :
    symplecticBilinear v (Pi.single (Fin.castAdd n i) 1) = v (Fin.natAdd n i) := by
  simp [symplecticBilinear, Pi.single_apply, fun k => (castAdd_ne_natAdd i k).symm,
    -Fin.natAdd_eq_addNat]

/-! ## The symplectic form as a bilinear form, and symplectic orthogonals -/

/-- `symplecticBilinear` as a bilinear form. -/
noncomputable def sympBilinForm (n : ℕ) : LinearMap.BilinForm (ZMod 2) (Fin (n + n) → ZMod 2) :=
  LinearMap.mk₂ (ZMod 2) symplecticBilinear symplecticBilinear_add_left
    symplecticBilinear_smul_left symplecticBilinear_add_right symplecticBilinear_smul_right

@[simp] lemma sympBilinForm_apply (v w : Fin (n + n) → ZMod 2) :
    sympBilinForm n v w = symplecticBilinear v w := rfl

/-- The symplectic form is reflexive. -/
lemma sympBilinForm_isRefl : (sympBilinForm n).IsRefl := fun v w h =>
  (symplecticBilinear_comm w v).trans h

/-- The symplectic form is nondegenerate: pairing with the basis vectors
recovers every coordinate. -/
lemma sympBilinForm_nondegenerate : (sympBilinForm n).Nondegenerate := by
  refine (sympBilinForm_isRefl.nondegenerate_iff_separatingLeft).mpr fun v hv => funext fun j => ?_
  refine Fin.addCases (fun i => ?_) (fun i => ?_) j
  · exact (symplecticBilinear_single_natAdd v i).symm.trans (hv _)
  · exact (symplecticBilinear_single_castAdd v i).symm.trans (hv _)

/-- The symplectic orthogonal of a submodule `W`: the vectors `v` with
`symplecticBilinear w v = 0` for all `w ∈ W`. -/
noncomputable abbrev sympOrthogonal (W : Submodule (ZMod 2) (Fin (n + n) → ZMod 2)) :
    Submodule (ZMod 2) (Fin (n + n) → ZMod 2) :=
  (sympBilinForm n).orthogonal W

/-- A vector is orthogonal to `W` iff `W` lies in the kernel of pairing with
it. -/
lemma mem_sympOrthogonal_iff_le_ker {W : Submodule (ZMod 2) (Fin (n + n) → ZMod 2)}
    {v : Fin (n + n) → ZMod 2} :
    v ∈ sympOrthogonal W ↔ W ≤ LinearMap.ker ((sympBilinForm n).flip v) :=
  Iff.rfl

/-- A vector is orthogonal to a span iff it is orthogonal to the spanning
set. -/
lemma mem_sympOrthogonal_span_iff (s : Set (Fin (n + n) → ZMod 2)) (v : Fin (n + n) → ZMod 2) :
    v ∈ sympOrthogonal (span (ZMod 2) s) ↔ ∀ w ∈ s, symplecticBilinear w v = 0 :=
  mem_sympOrthogonal_iff_le_ker.trans span_le

/-- The symplectic orthogonal of a sum is the intersection of the symplectic
orthogonals. -/
lemma sympOrthogonal_sup (P Q : Submodule (ZMod 2) (Fin (n + n) → ZMod 2)) :
    sympOrthogonal (P ⊔ Q) = sympOrthogonal P ⊓ sympOrthogonal Q :=
  Submodule.ext fun _ => mem_sympOrthogonal_iff_le_ker.trans sup_le_iff

/-- Adjoining to `V` a pair `x`, `z` of vectors that are orthogonal to `V` and
pair to `1` with each other raises the dimension by `2`. -/
lemma finrank_sup_span_pair {V : Submodule (ZMod 2) (Fin (n + n) → ZMod 2)}
    {x z : Fin (n + n) → ZMod 2} (hx : x ∈ sympOrthogonal V) (hz : z ∈ sympOrthogonal V)
    (hxz : symplecticBilinear x z = 1) :
    finrank (ZMod 2) ↥(V ⊔ span (ZMod 2) {x, z}) = finrank (ZMod 2) V + 2 := by
  have hzx : symplecticBilinear z x = 1 := by rwa [symplecticBilinear_comm]
  -- The coefficients of a combination of `x` and `z` are its pairings with `z` and `x`.
  have hpair : ∀ a b : ZMod 2, symplecticBilinear (a • x + b • z) z = a ∧
      symplecticBilinear (a • x + b • z) x = b := fun a b => by
    simp [symplecticBilinear_add_left, symplecticBilinear_smul_left, hxz, hzx,
      symplecticBilinear_self]
  have hind : LinearIndependent (ZMod 2) ![x, z] := by
    refine LinearIndependent.pair_iff.mpr fun a b hab => ?_
    have h := hpair a b
    rw [hab] at h
    exact ⟨h.1.symm.trans (LinearMap.map_zero₂ (sympBilinForm n) z),
      h.2.symm.trans (LinearMap.map_zero₂ (sympBilinForm n) x)⟩
  have hinf : V ⊓ span (ZMod 2) {x, z} = ⊥ := by
    refine (Submodule.eq_bot_iff _).mpr fun w ⟨hwV, hwU⟩ => ?_
    obtain ⟨a, b, rfl⟩ := mem_span_pair.mp hwU
    rw [(hpair a b).1.symm.trans (hz _ hwV), (hpair a b).2.symm.trans (hx _ hwV), zero_smul,
      zero_smul, add_zero]
  have hU : finrank (ZMod 2) (span (ZMod 2) {x, z}) = 2 := by
    rw [← Matrix.range_cons_cons_empty x z ![], finrank_span_eq_card hind, Fintype.card_fin]
  have h := Submodule.finrank_sup_add_finrank_inf_eq V (span (ZMod 2) {x, z})
  rwa [hinf, finrank_bot, add_zero, hU] at h

/-- Let `V` be an isotropic subspace of dimension `n - 1` and `x`, `z` vectors
orthogonal to `V` that pair to `1` with each other. Then every vector orthogonal
to `V`, `x` and `z` lies in `V`.

`V ⊔ span {x, z}` has dimension `n + 1`, so its orthogonal has dimension
`n - 1` and contains `V`; hence it equals `V`. -/
theorem mem_of_mem_sympOrthogonal_of_pair {V : Submodule (ZMod 2) (Fin (n + n) → ZMod 2)}
    {x z v : Fin (n + n) → ZMod 2} (hV : V ≤ sympOrthogonal V) (hdim : finrank (ZMod 2) V + 1 = n)
    (hx : x ∈ sympOrthogonal V) (hz : z ∈ sympOrthogonal V) (hxz : symplecticBilinear x z = 1)
    (hv : v ∈ sympOrthogonal V) (hxv : symplecticBilinear x v = 0)
    (hzv : symplecticBilinear z v = 0) : v ∈ V := by
  have hle : V ≤ sympOrthogonal (V ⊔ span (ZMod 2) {x, z}) :=
    (LinearMap.BilinForm.le_orthogonal_orthogonal sympBilinForm_isRefl).trans
      (LinearMap.BilinForm.orthogonal_le (sup_le hV (span_le.mpr (Set.pair_subset hx hz))))
  have hfin : finrank (ZMod 2) V =
      finrank (ZMod 2) (sympOrthogonal (V ⊔ span (ZMod 2) {x, z})) := by
    rw [LinearMap.BilinForm.finrank_orthogonal sympBilinForm_nondegenerate,
      finrank_sup_span_pair hx hz hxz, Module.finrank_fintype_fun_eq_card, Fintype.card_fin]
    omega
  rw [Submodule.eq_of_le_of_finrank_eq hle hfin, sympOrthogonal_sup, mem_inf,
    mem_sympOrthogonal_span_iff]
  exact ⟨hv, by rintro _ (rfl | rfl) <;> assumption⟩

end NQubitPauliOperator

namespace NQubitPauliGroupElement

open NQubitPauliOperator
open Submodule

/-- The symplectic vector of `op` is orthogonal to `sympSpan L` iff `op`
commutes with every element of `L`. -/
theorem mem_sympOrthogonal_sympSpan_iff (L : List (NQubitPauliGroupElement n))
    (op : NQubitPauliOperator n) :
    toSymplectic op ∈ sympOrthogonal (sympSpan L) ↔
      ∀ g ∈ L, NQubitPauliOperator.symplecticInner op g.operators = 0 := by
  rw [sympSpan_eq_span_listToSet, mem_sympOrthogonal_span_iff, Set.forall_mem_image]
  simp only [symplecticBilinear_comm _ (toSymplectic op), symplecticBilinear_toSymplectic]
  rfl

/-- Let `L` have linearly independent check-matrix rows, and let `x`, `z` be an
anticommuting pair of elements that commute with every element of `L`. Then
`L ++ [x, z]` has linearly independent check-matrix rows: pairing a vanishing
combination with `z` and with `x` shows that the coefficients of `x` and `z`
vanish. In particular the generators of a stabilizer code are independent of
any pair of logical operators `X̄`, `Z̄`. -/
theorem rowsLinearIndependent_append_pair {L : List (NQubitPauliGroupElement n)}
    (hL : rowsLinearIndependent L) {x z : NQubitPauliGroupElement n}
    (hx : ∀ g ∈ L, g * x = x * g) (hz : ∀ g ∈ L, g * z = z * g) (hxz : Anticommute x z) :
    rowsLinearIndependent (L ++ [x, z]) := by
  have hx' : toSymplectic x.operators ∈ sympOrthogonal (sympSpan L) :=
    (mem_sympOrthogonal_sympSpan_iff L _).mpr fun g hg =>
      (symplecticInner_comm _ _).trans ((commutes_iff_symplectic_inner_zero g x).mp (hx g hg))
  have hz' : toSymplectic z.operators ∈ sympOrthogonal (sympSpan L) :=
    (mem_sympOrthogonal_sympSpan_iff L _).mpr fun g hg =>
      (symplecticInner_comm _ _).trans ((commutes_iff_symplectic_inner_zero g z).mp (hz g hg))
  rw [rowsLinearIndependent_iff_length_eq_finrank_sympSpan, sympSpan_append, sympSpan_pair,
    finrank_sup_span_pair hx' hz' ((symplecticBilinear_toSymplectic _ _).trans
      ((anticommutes_iff_symplectic_inner_one x z).mp hxz)),
    ← (rowsLinearIndependent_iff_length_eq_finrank_sympSpan L).mp hL, List.length_append]
  rfl

/-- Suppose every weight-`w` operator that commutes with all elements of `L`
has its symplectic vector in `sympSpan L`. Then the stabilizer group generated
by `L` has no nontrivial logical operator of weight `w`. -/
theorem no_weight_w_logical_of_centralizer_in_span (L : List (NQubitPauliGroupElement n))
    (S : StabilizerGroup n) (w : ℕ)
    (h_closure : S.toSubgroup = Subgroup.closure (listToSet L))
    (h_span : ∀ op : NQubitPauliOperator n, NQubitPauliOperator.weight op = w →
      (∀ g ∈ L, NQubitPauliOperator.symplecticInner op g.operators = 0) →
      NQubitPauliOperator.toSymplectic op ∈ sympSpan L)
    (g : NQubitPauliGroupElement n) (hg_weight : weight g = w)
    (hg_nontrivial : StabilizerGroup.IsNontrivialLogicalOperator g S) : False := by
  obtain ⟨h_cent, h_ops_ne⟩ :=
    (StabilizerGroup.IsNontrivialLogicalOperator_iff g S).mp hg_nontrivial
  rw [StabilizerGroup.mem_centralizer_iff_closure g S (listToSet L) h_closure] at h_cent
  obtain ⟨s, hs, hs_eq⟩ := exists_mem_closure_of_symp_in_span L g.operators <|
    h_span g.operators hg_weight fun g' hg' =>
      (commutes_iff_symplectic_inner_zero g g').mp (h_cent g' hg').symm
  exact h_ops_ne s (h_closure ▸ hs) hs_eq

end NQubitPauliGroupElement

end Quantum
