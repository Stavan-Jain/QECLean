import Mathlib.Data.List.OfFn
import Mathlib.LinearAlgebra.LinearIndependent.Basic
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.LinearAlgebra.Span.Basic
import QEC.Stabilizer.Foundations.BinarySymplectic.Core
import QEC.Stabilizer.Foundations.BinarySymplectic.SymplecticInner
import QEC.Stabilizer.Foundations.BinarySymplectic.CheckMatrix
import QEC.Stabilizer.Framework.Core.Stabilizer.SubgroupLemmas
import QEC.Stabilizer.Foundations.PauliGroup.NQubitElement

/-!
# From row independence to independent generators

For a list `L` of n-qubit Pauli group elements, this file provides:

- `NQubitPauliGroupElement.listToSet L`: the set of elements of `L`, with its
  computation rules on `[]`, `a :: L`, `l₁ ++ l₂` and `List.ofFn f`;
- `NQubitPauliGroupElement.AllPhaseZero L`: every element of `L` has phase
  power `0`, a decidable property;
- `NQubitPauliGroupElement.rowsLinearIndependent_of_pivots` and its `List.ofFn`
  form `rowsLinearIndependent_ofFn_of_pivots`: the rows of the check matrix of
  `L` are linearly independent when each row has a pivot column in which every
  later row vanishes;
- `NQubitPauliGroupElement.rowsLinearIndependent_map` and
  `rowsLinearIndependent_map_of_nodup`: the rows of the check matrix of a
  mapped list `l.map g` are linearly independent when the symplectic vectors of
  the elements `g i` are and `l` has no repetitions
  (`rowsLinearIndependent_map_append_map` for two families listed one after the
  other);
- `NQubitPauliGroupElement.rowsLinearIndependent_implies_independentGenerators`:
  if the rows of the check matrix of `L` are linearly independent over `ZMod 2`,
  then no element of `L` lies in the subgroup generated by the others.

The converse of the last statement fails: the 1-qubit list `[X, Y, Z]` is an
independent generating set, but its check-matrix rows are linearly dependent.
-/

namespace Quantum

open scoped BigOperators
open Submodule
open NQubitPauliOperator

variable {n : ℕ}

namespace NQubitPauliGroupElement

/-- The set of elements appearing in the list `L`. -/
def listToSet (L : List (NQubitPauliGroupElement n)) : Set (NQubitPauliGroupElement n) :=
  setOf (· ∈ L)

/-- Every element of the list has phase power `0`, i.e. no global phase factor
`i`, `-1` or `-i`. -/
def AllPhaseZero (L : List (NQubitPauliGroupElement n)) : Prop :=
  ∀ g ∈ L, g.phasePower = 0

/-- `AllPhaseZero L` is a finite conjunction over the list, so it is decidable,
and `decide` closes it for any literal generator list.

The instance is spelled out as `List.decidableBAll` rather than found by
`inferInstance`: `NQubitPauliGroupElement n` is a `Fintype`, so instance
search would otherwise pick `Fintype.decidableForallFintype` for the bounded
quantifier and enumerate all `4 * 4 ^ n` group elements, which does not reduce
in any useful time. -/
instance instDecidableAllPhaseZero (L : List (NQubitPauliGroupElement n)) :
    Decidable (AllPhaseZero L) := by
  unfold AllPhaseZero
  exact List.decidableBAll _ L

/-!
## Computation rules for `listToSet` and `AllPhaseZero`

A generator list is either `List.ofFn f` or a literal `[g₁, g₂, …]`; these
lemmas compute `listToSet` and `AllPhaseZero` on both shapes.
-/

/-- The set of elements of `List.ofFn f` is `Set.range f`. -/
lemma listToSet_ofFn {k : ℕ} (f : Fin k → NQubitPauliGroupElement n) :
    listToSet (List.ofFn f) = Set.range f :=
  Set.ext fun g => List.mem_ofFn' f g

/-- `List.ofFn f` has all phase powers `0` if each `f i` has phase power `0`. -/
lemma AllPhaseZero_ofFn {k : ℕ} (f : Fin k → NQubitPauliGroupElement n)
    (h : ∀ i, (f i).phasePower = 0) : AllPhaseZero (List.ofFn f) :=
  (List.forall_mem_ofFn_iff
    (P := fun g : NQubitPauliGroupElement n => g.phasePower = 0)).mpr h

/-- The set of elements of `a :: L` is `insert a (listToSet L)`. -/
@[simp] lemma listToSet_cons (a : NQubitPauliGroupElement n)
    (L : List (NQubitPauliGroupElement n)) :
    listToSet (a :: L) = insert a (listToSet L) :=
  Set.ext fun _ => List.mem_cons

/-- The set of elements of the empty list is empty. -/
@[simp] lemma listToSet_nil : listToSet ([] : List (NQubitPauliGroupElement n)) = ∅ :=
  Set.ext fun _ => List.mem_nil_iff _

/-- The set of elements of `[a]` is `{a}`. -/
@[simp] lemma listToSet_singleton (a : NQubitPauliGroupElement n) : listToSet [a] = {a} :=
  Set.ext fun _ => List.mem_singleton

/-- The set of elements of `l₁ ++ l₂` is the union of the sets of elements of
`l₁` and of `l₂`. -/
lemma listToSet_append (l₁ l₂ : List (NQubitPauliGroupElement n)) :
    listToSet (l₁ ++ l₂) = listToSet l₁ ∪ listToSet l₂ :=
  Set.ext fun _ => List.mem_append

/-- `AllPhaseZero (a :: L)` iff `a` has phase power `0` and `AllPhaseZero L`. -/
lemma AllPhaseZero_cons (a : NQubitPauliGroupElement n) (L : List (NQubitPauliGroupElement n)) :
    AllPhaseZero (a :: L) ↔ a.phasePower = 0 ∧ AllPhaseZero L :=
  List.forall_mem_cons

/-- The empty list has all phase powers `0`. -/
@[simp] lemma AllPhaseZero_nil : AllPhaseZero ([] : List (NQubitPauliGroupElement n)) :=
  fun _ h => nomatch h

/-!
## Row independence from pivot columns

For a parametric generator list, row independence is read off the shape of the
check matrix: it suffices to name, for each row, a column where that row is `1`
and every later row is `0`.
-/

/-- Rows with a triangular system of pivot columns are linearly independent:
row `i` has a `1` in column `piv i`, and every later row has a `0` there. -/
theorem rowsLinearIndependent_of_pivots (L : List (NQubitPauliGroupElement n))
    (piv : Fin L.length → Fin (n + n))
    (h_diag : ∀ i, checkMatrix L i (piv i) = 1)
    (h_lower : ∀ i j, j < i → checkMatrix L i (piv j) = 0) :
    rowsLinearIndependent L := by
  rw [rowsLinearIndependent, Fintype.linearIndependent_iff]
  intro f hf j
  induction j using WellFoundedLT.induction with
  | ind j ih =>
    have h := congr_fun hf (piv j)
    rw [Finset.sum_apply, Finset.sum_eq_single j] at h
    · simpa [h_diag] using h
    · intro i _ hij
      rcases lt_or_gt_of_ne hij with hlt | hgt
      · simp [ih i hlt]
      · simp [h_lower i j hgt]
    · simp

/-- `rowsLinearIndependent_of_pivots` for the list `List.ofFn g`, with rows and
pivots indexed by the domain of `g`. -/
theorem rowsLinearIndependent_ofFn_of_pivots {m : ℕ} (g : Fin m → NQubitPauliGroupElement n)
    (piv : Fin m → Fin (n + n))
    (h_diag : ∀ i, toSymplectic (g i).operators (piv i) = 1)
    (h_lower : ∀ i j, j < i → toSymplectic (g i).operators (piv j) = 0) :
    rowsLinearIndependent (List.ofFn g) :=
  rowsLinearIndependent_of_pivots _ (fun i => piv (i.cast List.length_ofFn))
    (fun i => by simpa [checkMatrix] using h_diag _)
    (fun i j hij => by simpa [checkMatrix] using h_lower _ _ hij)

/-!
## Row independence of mapped lists
-/

/-- The empty list has linearly independent rows. -/
lemma rowsLinearIndependent_nil :
    rowsLinearIndependent ([] : List (NQubitPauliGroupElement n)) :=
  linearIndependent_empty_type (ι := Fin 0)

/-- The rows of `L.map f` are linearly independent iff the symplectic vectors
of the elements `f g`, for `g` in `L`, are. -/
lemma rowsLinearIndependent_map {m : ℕ}
    (f : NQubitPauliGroupElement n → NQubitPauliGroupElement m)
    (L : List (NQubitPauliGroupElement n)) :
    rowsLinearIndependent (L.map f) ↔
      LinearIndependent (ZMod 2) fun i : Fin L.length => toSymplectic (f (L.get i)).operators := by
  have key : (fun i => checkMatrix (L.map f) i) ∘ finCongr (List.length_map f).symm =
      fun i : Fin L.length => toSymplectic (f (L.get i)).operators := by
    funext i col
    simp [checkMatrix]
  rw [rowsLinearIndependent, ← linearIndependent_equiv (finCongr (List.length_map f).symm), key]

/-- If the symplectic vectors of the elements `g i` are linearly independent,
then the check matrix of `l.map g` has linearly independent rows for every
list `l` without repetitions. -/
lemma rowsLinearIndependent_map_of_nodup {ι : Type*}
    {g : ι → NQubitPauliGroupElement n}
    (hg : LinearIndependent (ZMod 2) fun i => toSymplectic (g i).operators)
    {l : List ι} (hl : l.Nodup) : rowsLinearIndependent (l.map g) := by
  have key : (fun k => checkMatrix (l.map g) k) =
      (fun i => toSymplectic (g i).operators) ∘ fun k => l.get (k.cast (List.length_map g)) := by
    funext k col
    simp [checkMatrix]
  rw [rowsLinearIndependent, key]
  exact hg.comp _ fun _ _ h => Fin.cast_injective _ (List.nodup_iff_injective_get.mp hl h)

/-- `rowsLinearIndependent_map_of_nodup` for two families `f` and `g` listed
one after the other. -/
lemma rowsLinearIndependent_map_append_map {ι κ : Type*}
    {f : ι → NQubitPauliGroupElement n} {g : κ → NQubitPauliGroupElement n}
    (h : LinearIndependent (ZMod 2) fun i => toSymplectic (Sum.elim f g i).operators)
    {l : List ι} {m : List κ} (hl : l.Nodup) (hm : m.Nodup) :
    rowsLinearIndependent (l.map f ++ m.map g) := by
  have hnd : (l.map Sum.inl ++ m.map Sum.inr : List (ι ⊕ κ)).Nodup :=
    (hl.map Sum.inl_injective).append (hm.map Sum.inr_injective) (by simp [List.Disjoint])
  simpa using rowsLinearIndependent_map_of_nodup h hnd

/-!
## Row independence implies independent generators
-/

/-- If the check-matrix rows of `L` are linearly independent, then the elements
of `L` form an independent generating set: an element in the subgroup generated
by the others would have its row in the span of the other rows. -/
theorem rowsLinearIndependent_implies_independentGenerators (L : List (NQubitPauliGroupElement n))
    (h : rowsLinearIndependent L) :
    Subgroup.IndependentGenerators (listToSet L) := by
  intro g hg h_mem
  obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hg
  refine h.notMem_span_image (s := {j | j ≠ i}) (fun hi => hi rfl)
    (span_mono ?_ (toSymplectic_mem_span_of_mem_closure h_mem))
  rintro _ ⟨y, ⟨hy, hne⟩, rfl⟩
  obtain ⟨j, rfl⟩ := List.mem_iff_get.mp hy
  exact ⟨j, fun hji => hne (congrArg L.get hji), rfl⟩

end NQubitPauliGroupElement

end Quantum
