import Mathlib.Data.ZMod.Basic
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.Data.List.Basic
import Mathlib.Data.Finset.NoncommProd
import Mathlib.Tactic
import QEC.Stabilizer.Foundations.BinarySymplectic.Core
import QEC.Stabilizer.Foundations.BinarySymplectic.SymplecticInner
import QEC.Stabilizer.Foundations.BinarySymplectic.CheckMatrix
import QEC.Stabilizer.Framework.Symplectic.IndependentEquiv
import QEC.Stabilizer.Foundations.PauliGroup.NQubitOperator
import QEC.Stabilizer.Foundations.PauliGroup.NQubitElement
import QEC.Stabilizer.Framework.Core.Stabilizer.StabilizerGroup

/-!
# Symplectic span of a generator list

For a list `L` of Pauli group elements, `sympSpan L` is the `𝔽₂`-span of the
rows of its check matrix. Up to phase, the subgroup generated by `L` is this
span:

- `mem_closure_implies_symp_in_span`: the symplectic vector of an element of
  `Subgroup.closure (listToSet L)` lies in `sympSpan L`;
- `exists_mem_closure_of_symp_in_span`: every operator whose symplectic vector
  lies in `sympSpan L` is the operator part of an element of the closure;
- `rowsLinearIndependent_append_iff`: the rows of `A ++ B` are linearly
  independent iff those of `A` and of `B` are and `sympSpan A`, `sympSpan B`
  are disjoint;
- `negIdentity_not_mem_of_indep_phase_zero_commute`: if the elements of `L`
  have phase `+1`, pairwise commute and have linearly independent check-matrix
  rows, then `−I` is not in the closure.

The first two rest on general facts about the symplectic vectors of a subgroup:
they form a subspace (`mem_span_image_toSymplectic_iff`), which is spanned by
the symplectic vectors of any generating set
(`span_image_toSymplectic_closure`).
-/

namespace Quantum

variable {n : ℕ}

namespace NQubitPauliGroupElement

open NQubitPauliOperator
open Submodule

/-! ## Symplectic vectors of a subgroup -/

/-- The symplectic vectors of the elements of a subgroup already form a
subspace: a vector lies in their span iff it is the symplectic vector of an
element of the subgroup. -/
lemma mem_span_image_toSymplectic_iff (H : Subgroup (NQubitPauliGroupElement n))
    (v : Fin (n + n) → ZMod 2) :
    v ∈ span (ZMod 2) ((fun g : NQubitPauliGroupElement n => toSymplectic g.operators) '' H) ↔
      ∃ g ∈ H, toSymplectic g.operators = v := by
  refine ⟨fun hv => ?_, fun ⟨g, hg, hgv⟩ => subset_span ⟨g, hg, hgv⟩⟩
  induction hv using span_induction with
  | mem x hx => exact hx
  | zero => exact ⟨1, H.one_mem, toSymplectic_one_operators⟩
  | add x y _ _ hx hy =>
    obtain ⟨g, hg, rfl⟩ := hx
    obtain ⟨h, hh, rfl⟩ := hy
    exact ⟨g * h, H.mul_mem hg hh, funext (toSymplectic_mul g h)⟩
  | smul a x _ hx =>
    obtain ⟨g, hg, rfl⟩ := hx
    obtain rfl | rfl : a = 0 ∨ a = 1 := by revert a; decide
    · exact ⟨1, H.one_mem, by rw [toSymplectic_one_operators, zero_smul]⟩
    · exact ⟨g, hg, (one_smul _ _).symm⟩

/-- Passing from a set of Pauli group elements to the subgroup it generates
does not enlarge the span of the symplectic vectors. -/
lemma span_image_toSymplectic_closure (G : Set (NQubitPauliGroupElement n)) :
    span (ZMod 2)
        ((fun g : NQubitPauliGroupElement n => toSymplectic g.operators) '' Subgroup.closure G) =
      span (ZMod 2) ((fun g => toSymplectic g.operators) '' G) :=
  le_antisymm
    (span_le.mpr fun _ ⟨_, hg, hgv⟩ => hgv ▸ toSymplectic_mem_span_of_mem_closure hg)
    (span_mono (Set.image_mono Subgroup.subset_closure))

/-! ## The symplectic span of a list -/

/-- The `𝔽₂`-span of the rows of the check matrix of `L`, i.e. of the symplectic
vectors of the elements of `L`. -/
def sympSpan (L : List (NQubitPauliGroupElement n)) : Submodule (ZMod 2) (Fin (n + n) → ZMod 2) :=
  span (ZMod 2) (Set.range (checkMatrix L))

/-- The span of the check-matrix rows equals the span of the symplectic image of
`listToSet L`. -/
lemma sympSpan_eq_span_listToSet (L : List (NQubitPauliGroupElement n)) :
    sympSpan L = span (ZMod 2) ((fun g => toSymplectic g.operators) '' listToSet L) := by
  rw [listToSet, ← Set.range_list_get, ← Set.range_comp]
  rfl

/-- The symplectic vector of an element of `L` lies in `sympSpan L`. -/
lemma toSymplectic_mem_sympSpan_of_mem {L : List (NQubitPauliGroupElement n)}
    {g : NQubitPauliGroupElement n} (hg : g ∈ L) : toSymplectic g.operators ∈ sympSpan L := by
  obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hg
  exact subset_span ⟨i, rfl⟩

/-- The symplectic vector of an element of the subgroup generated by `L` lies
in `sympSpan L`. -/
theorem mem_closure_implies_symp_in_span (L : List (NQubitPauliGroupElement n))
    (g : NQubitPauliGroupElement n) (hg : g ∈ Subgroup.closure (listToSet L)) :
    toSymplectic g.operators ∈ sympSpan L :=
  sympSpan_eq_span_listToSet L ▸ toSymplectic_mem_span_of_mem_closure hg

/-- Every operator whose symplectic vector lies in `sympSpan L` is the operator
part of an element of the subgroup generated by `L`. -/
theorem exists_mem_closure_of_symp_in_span (L : List (NQubitPauliGroupElement n))
    (op : NQubitPauliOperator n) (h_in_span : toSymplectic op ∈ sympSpan L) :
    ∃ s ∈ Subgroup.closure (listToSet L), s.operators = op := by
  rw [sympSpan_eq_span_listToSet, ← span_image_toSymplectic_closure,
    mem_span_image_toSymplectic_iff] at h_in_span
  obtain ⟨s, hs, hs_eq⟩ := h_in_span
  exact ⟨s, hs, toSymplectic_injective hs_eq⟩

/-- The rows of `A ++ B` are linearly independent iff the rows of `A` are, the
rows of `B` are, and the spans of the two sets of rows are disjoint. -/
theorem rowsLinearIndependent_append_iff (A B : List (NQubitPauliGroupElement n)) :
    rowsLinearIndependent (A ++ B) ↔
      rowsLinearIndependent A ∧ rowsLinearIndependent B ∧
        Disjoint (sympSpan A) (sympSpan B) := by
  let e : Fin A.length ⊕ Fin B.length ≃ Fin (A ++ B).length :=
    finSumFinEquiv.trans (finCongr List.length_append.symm)
  have key : (fun i => checkMatrix (A ++ B) i) ∘ e = Sum.elim (checkMatrix A) (checkMatrix B) := by
    funext s
    rcases s with i | j <;> funext col <;> simp [checkMatrix, e]
  rw [rowsLinearIndependent, ← linearIndependent_equiv e, key, linearIndependent_sum]
  simp only [Sum.elim_comp_inl, Sum.elim_comp_inr]
  rfl

/-- A sum of coordinates that vanishes on every row of the check matrix
vanishes on `sympSpan L`. -/
theorem sympSpan_sum_eq_zero (L : List (NQubitPauliGroupElement n)) (indices : Finset (Fin (n + n)))
    (h_mem : ∀ k : Fin L.length, Finset.sum indices (fun j => (checkMatrix L k) j) = 0) :
    ∀ v ∈ sympSpan L, Finset.sum indices (fun j => v j) = 0 := by
  intro v hv
  induction hv using span_induction with
  | mem x hx =>
    obtain ⟨k, rfl⟩ := hx
    exact h_mem k
  | zero => exact Finset.sum_const_zero
  | add x y _ _ hx hy => simp only [Pi.add_apply, Finset.sum_add_distrib, hx, hy, add_zero]
  | smul a x _ hx => simp only [Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum, hx, mul_zero]

/-!
## `−I` is not generated by independent commuting phase-zero generators

Pairwise commuting generators of phase `+1` square to `1`, so every element of
the subgroup they generate is the product `subsetProd L hC S` of the generators
with index in some finite set `S`. The symplectic vector of that product is the
sum of the corresponding check-matrix rows. If the rows are linearly
independent and the operator part of the product is the identity, then `S` is
empty and the product is `1`, not `−I`.
-/

variable (L : List (NQubitPauliGroupElement n))

/-- The product of the elements of `L` with index in `S`, for pairwise commuting
elements. -/
private noncomputable def subsetProd
    (hC : ∀ g ∈ listToSet L, ∀ h ∈ listToSet L, g * h = h * g)
    (S : Finset (Fin L.length)) : NQubitPauliGroupElement n :=
  S.noncommProd L.get fun i _ j _ _ => hC _ (L.get_mem i) _ (L.get_mem j)

private lemma subsetProd_insert
    (hC : ∀ g ∈ listToSet L, ∀ h ∈ listToSet L, g * h = h * g)
    {i : Fin L.length} {S : Finset (Fin L.length)} (hi : i ∉ S) :
    subsetProd L hC (insert i S) = L.get i * subsetProd L hC S :=
  Finset.noncommProd_insert_of_notMem _ _ _ _ hi

/-- The symplectic vector of `subsetProd L hC S` is the sum of the check-matrix
rows with index in `S`. -/
private lemma toSymplectic_subsetProd
    (hC : ∀ g ∈ listToSet L, ∀ h ∈ listToSet L, g * h = h * g)
    (S : Finset (Fin L.length)) :
    toSymplectic (subsetProd L hC S).operators = ∑ i ∈ S, checkMatrix L i := by
  classical
  induction S using Finset.induction_on with
  | empty => exact toSymplectic_one_operators
  | insert i T hi ih =>
    rw [subsetProd_insert L hC hi, Finset.sum_insert hi, ← ih]
    exact funext (toSymplectic_mul _ _)

/-- Every element of the subgroup generated by pairwise commuting phase-zero
elements is a product of distinct generators. -/
private lemma exists_eq_subsetProd (hPhase : AllPhaseZero L)
    (hC : ∀ g ∈ listToSet L, ∀ h ∈ listToSet L, g * h = h * g)
    {g : NQubitPauliGroupElement n} (hg : g ∈ Subgroup.closure (listToSet L)) :
    ∃ S, g = subsetProd L hC S := by
  classical
  -- A phase-zero element is its own inverse.
  have hinv : ∀ x ∈ listToSet L, x⁻¹ = x := fun x hx =>
    NQubitPauliGroupElement.ext _ _ (by change -x.phasePower = _; rw [hPhase x hx, neg_zero]) rfl
  have hmul : ∀ x ∈ listToSet L, ∀ y, (∃ S, y = subsetProd L hC S) →
      ∃ S, x * y = subsetProd L hC S := by
    rintro x hx _ ⟨S, rfl⟩
    obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hx
    by_cases hi : i ∈ S
    · have hS := subsetProd_insert L hC (Finset.notMem_erase i S)
      rw [Finset.insert_erase hi] at hS
      exact ⟨S.erase i, by rw [hS, ← _root_.mul_assoc,
        mul_eq_one_iff_eq_inv.mpr (hinv _ hx).symm, _root_.one_mul]⟩
    · exact ⟨insert i S, (subsetProd_insert L hC hi).symm⟩
  induction hg using Subgroup.closure_induction_left with
  | one => exact ⟨∅, (Finset.noncommProd_empty _ _).symm⟩
  | mul_left x hx y _ ih => exact hmul x hx y ih
  | inv_mul_cancel x hx y _ ih => exact (hinv x hx).symm ▸ hmul x hx y ih

/-- If the generators in `L` have phase `+1`, pairwise commute and have linearly
independent check-matrix rows, then `−I` is not in the subgroup they
generate. -/
theorem negIdentity_not_mem_of_indep_phase_zero_commute
    (hPhase : AllPhaseZero L)
    (hIndep : rowsLinearIndependent L)
    (hC : ∀ g ∈ listToSet L, ∀ h ∈ listToSet L, g * h = h * g) :
    StabilizerGroup.negIdentity n ∉ Subgroup.closure (listToSet L) := by
  intro hneg
  obtain ⟨S, hS⟩ := exists_eq_subsetProd L hPhase hC hneg
  -- The rows with index in `S` sum to zero, so `S` is empty by independence.
  have hsum : ∑ i ∈ S, (1 : ZMod 2) • checkMatrix L i = 0 := by
    simp only [one_smul, ← toSymplectic_subsetProd L hC S, ← hS]
    exact toSymplectic_one_operators
  have hS_empty : S = ∅ := Finset.eq_empty_of_forall_notMem fun i hi =>
    one_ne_zero (linearIndependent_iff'.mp hIndep S (fun _ => 1) hsum i hi)
  rw [hS_empty] at hS
  exact StabilizerGroup.negIdentity_ne_one n (hS.trans (Finset.noncommProd_empty _ _))

end NQubitPauliGroupElement

end Quantum
