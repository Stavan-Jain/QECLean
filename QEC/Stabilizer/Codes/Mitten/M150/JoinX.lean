/-- Grouping preserves the first census exactly. -/
private theorem joinLeftX : joinLeft joinBucketsX = clsX0 := by
  decide +kernel

/-- Grouping preserves the second census exactly. -/
private theorem joinRightX : joinRight joinBucketsX = clsX1 := by
  decide +kernel

/-- Every compatible low-weight pair joins to a generator row. -/
private theorem joinBucketsX_checked :
    checkJoinBuckets rowsXpk 0 joinBucketsX = true := by
  decide +kernel

/-- The complete join is certified through shared-block grouping. -/
theorem checkJoin_X : checkJoin clsX0 clsX1 rowsXpk = true := by
  rw [← joinLeftX, ← joinRightX]
  exact checkJoin_of_buckets rowsXpk joinBucketsX joinBucketsX_checked

#print axioms checkJoin_X

