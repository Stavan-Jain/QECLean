/-- Grouping preserves the first census exactly. -/
private theorem joinLeftZ : joinLeft joinBucketsZ = clsZ0 := by
  decide +kernel

/-- Grouping preserves the second census exactly. -/
private theorem joinRightZ : joinRight joinBucketsZ = clsZ1 := by
  decide +kernel

/-- Every compatible low-weight pair joins to a generator row. -/
private theorem joinBucketsZ_checked :
    checkJoinBuckets rowsZpk 0 joinBucketsZ = true := by
  decide +kernel

/-- The complete join is certified through shared-block grouping. -/
theorem checkJoin_Z : checkJoin clsZ0 clsZ1 rowsZpk = true := by
  rw [← joinLeftZ, ← joinRightZ]
  exact checkJoin_of_buckets rowsZpk joinBucketsZ joinBucketsZ_checked

#print axioms checkJoin_Z

end Quantum.Stabilizer.Homological.LP.M150
