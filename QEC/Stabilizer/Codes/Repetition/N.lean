/-!
# The repetition code on `n + 2` qubits `[[n+2, 1, 1]]`

The parametric version of `RepetitionCode3`, on `n + 2` qubits so that the
adjacent pairs are indexed by `Fin (n + 1)`. The generators are the `Z`-checks
`Z_i Z_{i+1}` on qubits `i` and `i + 1`; there are no `X`-checks. It encodes
one logical qubit.

Being parametric, the family takes the **CSS route** rather than the decide
route: the generator list is a `List.ofFn` that `decide` cannot evaluate. The
generators commute because they are all Z-type, `−I ∉ closure` because a
Z-type element has phase power `0`, and the check-matrix rows are independent
because row `i` is the first with a `1` in the `Z`-column of qubit `i`.

As a *quantum* code it has distance 1 for every `n`: `Z` on qubit `0` commutes
with every check but anticommutes with `X⊗ⁿ⁺²`, which also commutes with every
check, so it is a nontrivial logical of weight 1.

The logical basis `X̄ = X⊗ⁿ⁺²`, `Z̄ = Z⊗ⁿ⁺²` (for odd `n + 2`) is in
`NLogicals.lean`.

## Outline

- Generators `ZPair`, the list `generatorsList`, the set `generators` and the
  subgroup `subgroup` it generates
- Hypotheses on the generators: `generators_isZType`, `generators_commute`,
  `AllPhaseZero_generatorsList`, `rowsLinearIndependent_generatorsList`
- `negIdentity_not_mem`, the bundled `stabilizerGroup`
- `presentation`, `stabilizerCode : Code[[n+2, 1]]`
- Distance 1 (weight-1 logical): `code_has_distance_one`,
  `stabilizerCodeWithDistance : Code[[n+2, 1, 1]]`
-/

namespace Quantum
namespace StabilizerGroup
namespace RepetitionCodeN

open NQubitPauliGroupElement
open scoped Pauli

/-! ## Generators -/

/-- The adjacent Z-check `Z_i Z_{i+1}` on `n + 2` qubits. -/
def ZPair (n : ℕ) (i : Fin (n + 1)) : NQubitPauliGroupElement (n + 2) :=
  σ[n + 2 | Fin.castSucc i ↦ Z, Fin.succ i ↦ Z]

/-- `Z_i Z_{i+1}` is `Z` on the pair of qubits `{i, i + 1}`. -/
lemma ZPair_eq_zOn (n : ℕ) (i : Fin (n + 1)) :
    ZPair n i = zOn {Fin.castSucc i, Fin.succ i} :=
  (zOn_pair _ _).symm

/-- The `n + 1` generators as a list. -/
def generatorsList (n : ℕ) : List (NQubitPauliGroupElement (n + 2)) :=
  List.ofFn (ZPair n)

/-- The `n + 1` generators as a set. -/
def generators (n : ℕ) : Set (NQubitPauliGroupElement (n + 2)) :=
  Set.range (ZPair n)

/-- The subgroup generated by the adjacent Z-checks. -/
noncomputable def subgroup (n : ℕ) : Subgroup (NQubitPauliGroupElement (n + 2)) :=
  Subgroup.closure (generators n)

/-- The generator list has the elements of the generator set. -/
lemma listToSet_generatorsList (n : ℕ) : listToSet (generatorsList n) = generators n :=
  listToSet_ofFn _

/-! ## Hypotheses on the generators

All generators are Z-type, so they commute componentwise and have phase power
`0`. For independence, the pivot of row `i` is the `Z`-column of qubit `i`:
`Z_i Z_{i+1}` has a `1` there, and the later rows `Z_j Z_{j+1}`, `j > i`, do
not touch qubit `i`. -/

/-- Every generator is Z-type. -/
lemma generators_isZType (n : ℕ) : ∀ g ∈ generators n, IsZTypeElement g := by
  rintro _ ⟨i, rfl⟩
  exact ZPair_eq_zOn n i ▸ IsZTypeElement_zOn _

/-- All generators pairwise commute. -/
lemma generators_commute (n : ℕ) : ∀ g ∈ generators n, ∀ h ∈ generators n, g * h = h * g :=
  fun g hg h hh => (generators_isZType n g hg).commute (generators_isZType n h hh)

/-- Every generator has phase power 0. -/
lemma AllPhaseZero_generatorsList (n : ℕ) : AllPhaseZero (generatorsList n) :=
  AllPhaseZero_ofFn (ZPair n) fun _ => rfl

/-- The check-matrix rows of the `n + 1` generators are linearly independent. -/
lemma rowsLinearIndependent_generatorsList (n : ℕ) :
    rowsLinearIndependent (generatorsList n) :=
  rowsLinearIndependent_ofFn_of_pivots (ZPair n) (fun i => Fin.natAdd (n + 2) (Fin.castSucc i))
    (fun i => by rw [ZPair_eq_zOn, toSymplectic_zOn_natAdd, if_pos (by simp)])
    (fun i j hij => by
      have hij := Fin.lt_def.mp hij
      rw [ZPair_eq_zOn, toSymplectic_zOn_natAdd, if_neg]
      simp only [Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff, Fin.val_castSucc,
        Fin.val_succ]
      omega)

/-! ## No `−I` in the stabilizer subgroup -/

/-- The closure of the generators does not contain `−I`: its elements are
Z-type, so they have phase power `0`. -/
lemma negIdentity_not_mem (n : ℕ) : negIdentity (n + 2) ∉ subgroup n := fun h =>
  absurd (IsZTypeElement_of_mem_closure (generators_isZType n) _ h).1 (by simp)

/-! ## Bundled `StabilizerGroup (n + 2)` -/

/-- The stabilizer group of the repetition code on `n + 2` qubits, generated by
`generatorsList n`. -/
noncomputable def stabilizerGroup (n : ℕ) : StabilizerGroup (n + 2) :=
  mkStabilizerFromGenerators (n + 2) (generatorsList n)
    (by rw [listToSet_generatorsList]; exact generators_commute n)
    (by rw [listToSet_generatorsList]; exact negIdentity_not_mem n)

/-- The stabilizer subgroup is the closure of the generator set. -/
lemma stabilizerGroup_toSubgroup_eq (n : ℕ) : (stabilizerGroup n).toSubgroup = subgroup n :=
  congrArg Subgroup.closure (listToSet_generatorsList n)

/-! ## The bare code `Code[[n+2, 1]]`

`n + 1` independent, pairwise commuting generators on `n + 2` qubits: one
logical qubit, for every `n`. -/

/-- The generator list as a presentation of an `[[n+2, 1]]` code: its `n + 1`
check-matrix rows are linearly independent. -/
def presentation (n : ℕ) : StabilizerCode.Presentation (n + 2) 1 where
  hk := by omega
  generatorsList := generatorsList n
  generators_length := List.length_ofFn
  generators_phaseZero := AllPhaseZero_generatorsList n
  generators_independent := rowsLinearIndependent_generatorsList n
  generators_commute := by
    have h := generators_commute n
    rw [← listToSet_generatorsList] at h
    exact h
  closure_no_neg_identity := by rw [listToSet_generatorsList]; exact negIdentity_not_mem n

/-- The repetition code on `n + 2` qubits as a stabilizer code `[[n+2, 1]]`. -/
noncomputable def stabilizerCode (n : ℕ) : Code[[n + 2, 1]] := (presentation n).toCode

/-- The stabilizer code's subgroup is the closure of the generator set. -/
lemma stabilizerCode_toSubgroup_eq (n : ℕ) :
    (stabilizerCode n).toStabilizerGroup.toSubgroup = subgroup n :=
  stabilizerGroup_toSubgroup_eq n

/-! ## Distance 1

Every nontrivial logical of positive weight trivially has weight at least 1,
so there is no lower bound to prove: only a weight-1 witness.

### A nontrivial logical of weight 1

`Z` on qubit `0` commutes with every check (all are Z-type), and it
anticommutes with `X⊗ⁿ⁺²` (one shared qubit), which meets each check on two
qubits and so also commutes with every check. This needs no parity assumption
on `n`. -/

/-- `Z` on qubit `0`: a nontrivial logical of weight 1. -/
def minWeightLogical (n : ℕ) : NQubitPauliGroupElement (n + 2) :=
  σ[n + 2 | 0 ↦ Z]

/-- `X⊗ⁿ⁺²`: a centralizer element anticommuting with `minWeightLogical`. -/
def minWeightPartner (n : ℕ) : NQubitPauliGroupElement (n + 2) :=
  ⟨0, NQubitPauliOperator.X (n + 2)⟩

/-- `minWeightLogical n` is `Z` on the support `{0}`. -/
lemma minWeightLogical_eq_zOn (n : ℕ) : minWeightLogical n = zOn {0} :=
  (zOn_singleton 0).symm

/-- `Z` on qubit `0` has weight 1. -/
lemma minWeightLogical_weight (n : ℕ) : weight (minWeightLogical n) = 1 := by
  rw [minWeightLogical_eq_zOn, weight_zOn, Finset.card_singleton]

/-- `Z` on qubit `0` commutes with every element of the stabilizer. -/
lemma minWeightLogical_mem_centralizer (n : ℕ) :
    minWeightLogical n ∈ centralizer (stabilizerGroup n) :=
  (mem_centralizer_iff_closure _ _ (generators n) (stabilizerGroup_toSubgroup_eq n)).mpr
    fun s hs =>
      (generators_isZType n s hs).commute (minWeightLogical_eq_zOn n ▸ IsZTypeElement_zOn _)

/-- `X⊗ⁿ⁺²` commutes with every element of the stabilizer: it meets each check
`Z_i Z_{i+1}` on two qubits. -/
lemma minWeightPartner_mem_centralizer (n : ℕ) :
    minWeightPartner n ∈ centralizer (stabilizerGroup n) := by
  rw [mem_centralizer_iff_closure _ _ (generators n) (stabilizerGroup_toSubgroup_eq n)]
  rintro _ ⟨i, rfl⟩
  rw [minWeightPartner, ← xOn_univ, ZPair_eq_zOn, eq_comm, commutes_xOn_zOn_iff,
    Finset.univ_inter, Finset.card_pair Fin.castSucc_lt_succ.ne]
  exact even_two

/-- `Z` on qubit `0` and `X⊗ⁿ⁺²` meet on qubit `0` only, an odd number. -/
lemma minWeightLogical_anticommutes_minWeightPartner (n : ℕ) :
    Anticommute (minWeightLogical n) (minWeightPartner n) := by
  refine anticommute_symm _ _ ?_
  rw [minWeightPartner, minWeightLogical_eq_zOn, ← xOn_univ, anticommute_xOn_zOn_iff,
    Finset.univ_inter, Finset.card_singleton]
  exact odd_one

/-- `Z` on qubit `0` is a nontrivial logical operator: it lies in the
centralizer and anticommutes with the centralizer element `minWeightPartner`. -/
lemma minWeightLogical_isNontrivial (n : ℕ) :
    IsNontrivialLogicalOperator (minWeightLogical n) (stabilizerCode n).toStabilizerGroup :=
  isNontrivialLogicalOperator_of_anticommute_centralizer _ (minWeightLogical_mem_centralizer n)
    (minWeightPartner_mem_centralizer n) (minWeightLogical_anticommutes_minWeightPartner n)

/-! ### The code with its distance `Code[[n+2, 1, 1]]` -/

/-- **The repetition code has distance 1.** Every nontrivial logical of
positive weight has weight at least 1, and `Z` on qubit `0` attains it. -/
theorem code_has_distance_one (n : ℕ) : HasCodeDistance (stabilizerCode n) 1 :=
  ⟨le_rfl, fun _ _ hw => hw, minWeightLogical n, minWeightLogical_isNontrivial n,
    minWeightLogical_weight n⟩

/-- The repetition code on `n + 2` qubits packaged with its distance. -/
noncomputable def stabilizerCodeWithDistance (n : ℕ) : Code[[n + 2, 1, 1]] where
  toStabilizerCode := stabilizerCode n
  hasDistance := code_has_distance_one n

end RepetitionCodeN
end StabilizerGroup
end Quantum
