-- Elaborating this packed certificate can exceed the default heartbeat budget.
/-- Every listed cap-one fiber is impossible with at most one outside coordinate. -/
theorem cap1_impossible (i : Fin 20904) (word : Nat) (hw : word < 2^90)
    (he : reconX bottomEColumns word = reconX bottomRColumns (beta1 i.val))
    (hoff : bitCount 90 (outsideMask word (beta1 i.val)) ≤ 1) : False := by
  have hm := Nat.mod_lt i.val (by decide : 0 < 1024)
  have heq := Nat.mod_add_div i.val 1024
  have hb : i.val / 1024 < 21 := by omega
  have hl : i.val % 1024 < size1 (i.val / 1024) := by
    unfold size1
    split_ifs <;> omega
  exact cap1_batch_impossible _ hb _ hl word hw he hoff
