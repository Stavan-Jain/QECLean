    (he : reconX bottomEColumns word = reconX bottomRColumns (lane 256 i beta1Words20))
    (hoff : bitCount 90 (outsideMask word (lane 256 i beta1Words20)) ≤ 1) : False := by
  have h := checked1_20
  rw [rep424_eq] at h
  have hc := h.2.2.1
  simp only [List.all_eq_true,Bool.and_eq_true,Nat.blt_eq,Nat.beq_eq] at hc
  exact cap1_raw_impossible 256 424 90 7 beta1Words20 coeff1Words20 (by decide) (by decide) (by decide) (by decide)
    h.1 h.2.1 bottomDualColumns bottomEColumns bottomRColumns bottomDualColumns_bounded
    (fun c hm => (hc c hm).1) (fun c hm => (hc c hm).2) h.2.2.2.1 h.2.2.2.2
    bottomDual_constraint i hi word hw he hoff
set_option maxHeartbeats 0 in
