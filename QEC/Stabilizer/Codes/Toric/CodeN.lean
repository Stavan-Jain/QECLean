import QEC.Stabilizer.Framework.Core.Stabilizer.GeneratorListLemmas
import QEC.Stabilizer.Framework.Core.Stabilizer.StabilizerGroup
import QEC.Stabilizer.Framework.Homological.StabGroup
import QEC.Stabilizer.Framework.Symplectic.SupportLemmas
import QEC.Stabilizer.Codes.Toric.ChainOps

/-!
# The toric code: checks and stabilizer group

The toric code on the `L × L` periodic square lattice has one qubit on every
edge, a Z-check on every vertex and an X-check on every face.

* `numQubits L = 2 * L * L` is the number of qubits; `hEdge L x y` and
  `vEdge L x y` are the qubits of the horizontal and the vertical edge at the
  site `(x, y)`.
* `vertexStab L x y` is `Z` on the four edges at the vertex `(x, y)`, and
  `faceStab L x y` is `X` on the four edges around the face `(x, y)`.
* `ZGenerators L`, `XGenerators L` and `generators L` are the checks as sets;
  `generatorsListZ L`, `generatorsListX L` and `generatorsList L` are the
  checks as lists.
* For `2 ≤ L` the checks are the vertex and face checks of
  `toricHomologicalCode L` (`vertexStab_eq_vertexStabOf`,
  `faceStab_eq_faceStabOf`), so they pairwise commute (`generators_commute`)
  and do not generate `-I` (`negIdentity_not_mem`).
* `stabilizerGroup L` is the stabilizer group generated by `generatorsList L`.
  It has the same subgroup as the homological stabilizer group of
  `toricHomologicalCode L`
  (`stabilizerGroup_toSubgroup_eq_homologicalStabilizerGroup`).

For `L = 1` the four edges at a vertex are not distinct, which is why the
comparison with the chain complex assumes `2 ≤ L`.

The list `generatorsList L` has `2 * L * L` entries, two more than an
independent generating set: the product of all vertex checks is the identity,
and so is the product of all face checks. The `StabilizerCode` of the toric
code is therefore presented by a shorter list, in
`QEC.Stabilizer.Codes.Toric.StabilizerCode`.
-/

namespace Quantum
namespace StabilizerGroup
namespace ToricCodeN

open NQubitPauliGroupElement NQubitPauliOperator
open Stabilizer.Lattice Stabilizer.Homological
open scoped ToricChain
open scoped Pauli

/-! ## Qubits -/

/-- The number of physical qubits, `2 * L * L`: one per edge. -/
abbrev numQubits (L : ℕ) : ℕ := 2 * L * L

/-- The qubit of the horizontal edge at the site `(x, y)`, numbered
`y * L + x`. -/
abbrev hEdge (L : ℕ) (x y : Fin L) : Fin (numQubits L) := edgeToQubitIdx L (EdgeIdx.h x y)

/-- The qubit of the vertical edge at the site `(x, y)`, numbered
`L * L + y * L + x`. -/
abbrev vEdge (L : ℕ) (x y : Fin L) : Fin (numQubits L) := edgeToQubitIdx L (EdgeIdx.v x y)

/-- Horizontal edges at distinct sites have distinct qubits. -/
lemma hEdge_eq_iff (L : ℕ) [Fact (0 < L)] (x₁ y₁ x₂ y₂ : Fin L) :
    hEdge L x₁ y₁ = hEdge L x₂ y₂ ↔ x₁ = x₂ ∧ y₁ = y₂ := by
  rw [(edgeToQubitIdx_injective L).eq_iff, EdgeIdx.h.injEq]

/-- Vertical edges at distinct sites have distinct qubits. -/
lemma vEdge_eq_iff (L : ℕ) [Fact (0 < L)] (x₁ y₁ x₂ y₂ : Fin L) :
    vEdge L x₁ y₁ = vEdge L x₂ y₂ ↔ x₁ = x₂ ∧ y₁ = y₂ := by
  rw [(edgeToQubitIdx_injective L).eq_iff, EdgeIdx.v.injEq]

/-- A horizontal and a vertical edge never share a qubit. -/
lemma hEdge_ne_vEdge (L : ℕ) (x₁ y₁ x₂ y₂ : Fin L) : hEdge L x₁ y₁ ≠ vEdge L x₂ y₂ :=
  fin_ne_of_val_lt_offset_le (edgeToQubitIdx_h_lt_sq L x₁ y₁) (edgeToQubitIdx_v_ge_sq L x₂ y₂)

section Checks

variable (L : ℕ) [Fact (0 < L)]

/-! ## Checks -/

/-- The vertex check at `(x, y)`: `Z` on the four edges incident to the
vertex. -/
def vertexStab (x y : Fin L) : NQubitPauliGroupElement (numQubits L) :=
  σ[numQubits L | hEdge L x y ↦ Z, hEdge L (prev L x) y ↦ Z,
    vEdge L x y ↦ Z, vEdge L x (prev L y) ↦ Z]

/-- The face check at `(x, y)`: `X` on the four edges around the face. -/
def faceStab (x y : Fin L) : NQubitPauliGroupElement (numQubits L) :=
  σ[numQubits L | hEdge L x y ↦ X, hEdge L x (next L y) ↦ X,
    vEdge L x y ↦ X, vEdge L (next L x) y ↦ X]

/-- Every vertex check is Z-type. -/
lemma vertexStab_isZType (x y : Fin L) : IsZTypeElement (vertexStab L x y) :=
  ⟨rfl, IsZType_set_Z_of_IsZType _ _ <| IsZType_set_Z_of_IsZType _ _ <|
    IsZType_set_Z_of_IsZType _ _ <| IsZType_set_Z_of_IsZType _ _ IsZType_identity⟩

/-- Every face check is X-type. -/
lemma faceStab_isXType (x y : Fin L) : IsXTypeElement (faceStab L x y) :=
  ⟨rfl, IsXType_set_X_of_IsXType _ _ <| IsXType_set_X_of_IsXType _ _ <|
    IsXType_set_X_of_IsXType _ _ <| IsXType_set_X_of_IsXType _ _ IsXType_identity⟩

/-- The vertex check at `(x, y)` on the qubit of the edge `e`. -/
lemma vertexStab_operators_edgeToQubitIdx (x y : Fin L) (e : EdgeIdx L) :
    (vertexStab L x y).operators (edgeToQubitIdx L e) =
      if e = EdgeIdx.h x y ∨ e = EdgeIdx.h (prev L x) y ∨
          e = EdgeIdx.v x y ∨ e = EdgeIdx.v x (prev L y)
        then PauliOperator.Z else PauliOperator.I := by
  simp only [vertexStab, NQubitPauliOperator.set, (edgeToQubitIdx_injective L).eq_iff]
  split_ifs <;> simp_all [NQubitPauliOperator.identity]

/-- The face check at `(x, y)` on the qubit of the edge `e`. -/
lemma faceStab_operators_edgeToQubitIdx (x y : Fin L) (e : EdgeIdx L) :
    (faceStab L x y).operators (edgeToQubitIdx L e) =
      if e = EdgeIdx.h x y ∨ e = EdgeIdx.h x (next L y) ∨
          e = EdgeIdx.v x y ∨ e = EdgeIdx.v (next L x) y
        then PauliOperator.X else PauliOperator.I := by
  simp only [faceStab, NQubitPauliOperator.set, (edgeToQubitIdx_injective L).eq_iff]
  split_ifs <;> simp_all [NQubitPauliOperator.identity]

/-- The support of a vertex check consists of the qubits of the four edges at
the vertex. -/
lemma mem_support_vertexStab_iff (x y : Fin L) (i : Fin (numQubits L)) :
    i ∈ (vertexStab L x y).operators.support ↔
      i = hEdge L x y ∨ i = hEdge L (prev L x) y ∨
      i = vEdge L x y ∨ i = vEdge L x (prev L y) := by
  obtain ⟨e, rfl⟩ := (toricEdgeEquiv L).surjective i
  rw [toricEdgeEquiv_apply, NQubitPauliOperator.mem_support, vertexStab_operators_edgeToQubitIdx]
  simp only [(edgeToQubitIdx_injective L).eq_iff]
  split_ifs with h <;> simp [h]

/-- The support of a face check consists of the qubits of the four edges
around the face. -/
lemma mem_support_faceStab_iff (x y : Fin L) (i : Fin (numQubits L)) :
    i ∈ (faceStab L x y).operators.support ↔
      i = hEdge L x y ∨ i = hEdge L x (next L y) ∨
      i = vEdge L x y ∨ i = vEdge L (next L x) y := by
  obtain ⟨e, rfl⟩ := (toricEdgeEquiv L).surjective i
  rw [toricEdgeEquiv_apply, NQubitPauliOperator.mem_support, faceStab_operators_edgeToQubitIdx]
  simp only [(edgeToQubitIdx_injective L).eq_iff]
  split_ifs with h <;> simp [h]

/-! ## Generator sets and lists -/

/-- The set of Z-checks: one vertex check per vertex. -/
def ZGenerators : Set (NQubitPauliGroupElement (numQubits L)) :=
  Set.range fun p : Fin L × Fin L => vertexStab L p.1 p.2

/-- The set of X-checks: one face check per face. -/
def XGenerators : Set (NQubitPauliGroupElement (numQubits L)) :=
  Set.range fun p : Fin L × Fin L => faceStab L p.1 p.2

/-- The set of all checks. -/
def generators : Set (NQubitPauliGroupElement (numQubits L)) :=
  ZGenerators L ∪ XGenerators L

/-- Every Z-check is Z-type. -/
lemma ZGenerators_isZType : ∀ g ∈ ZGenerators L, IsZTypeElement g := by
  rintro _ ⟨p, rfl⟩
  exact vertexStab_isZType L p.1 p.2

/-- Every X-check is X-type. -/
lemma XGenerators_isXType : ∀ g ∈ XGenerators L, IsXTypeElement g := by
  rintro _ ⟨p, rfl⟩
  exact faceStab_isXType L p.1 p.2

/-- The list of all sites `(x, y)` of the lattice. -/
def coords (L : ℕ) : List (Fin L × Fin L) :=
  (List.finRange L).product (List.finRange L)

/-- The list of all Z-checks. -/
def generatorsListZ : List (NQubitPauliGroupElement (numQubits L)) :=
  (coords L).map fun p => vertexStab L p.1 p.2

/-- The list of all X-checks. -/
def generatorsListX : List (NQubitPauliGroupElement (numQubits L)) :=
  (coords L).map fun p => faceStab L p.1 p.2

/-- The list of all checks: the Z-checks followed by the X-checks. -/
def generatorsList : List (NQubitPauliGroupElement (numQubits L)) :=
  generatorsListZ L ++ generatorsListX L

lemma listToSet_generatorsListZ : listToSet (generatorsListZ L) = ZGenerators L :=
  GeneratorListLemmas.listToSet_map_product_finRange_eq_range _

lemma listToSet_generatorsListX : listToSet (generatorsListX L) = XGenerators L :=
  GeneratorListLemmas.listToSet_map_product_finRange_eq_range _

lemma listToSet_generatorsList : listToSet (generatorsList L) = generators L := by
  rw [generators, generatorsList, listToSet_append, listToSet_generatorsListZ,
    listToSet_generatorsListX]

/-- The subgroup generated by the checks. -/
noncomputable def subgroup : Subgroup (NQubitPauliGroupElement (numQubits L)) :=
  Subgroup.closure (generators L)

end Checks

section HomologicalCode

variable (L : ℕ) [Fact (2 ≤ L)]

/-! ## The checks as checks of the chain complex -/

/-- The vertex check at `(x, y)` is the Z-chain operator of the cut of the
vertex. -/
theorem vertexStab_eq_toricZOperatorOfChain (x y : Fin L) :
    vertexStab L x y = toricZOperatorOfChain L (δ⁰ L (singleVtx (x, y))) := by
  refine NQubitPauliGroupElement.ext _ _ rfl (funext fun q => ?_)
  obtain ⟨e, rfl⟩ := (toricEdgeEquiv L).surjective q
  rw [toricEdgeEquiv_apply, toricZOperatorOfChain_operators_edgeToQubitIdx,
    vertexStab_operators_edgeToQubitIdx]
  exact if_congr (toricVertexCutMap_singleVtx_eq_one_iff L x y e).symm rfl rfl

/-- The face check at `(x, y)` is the X-chain operator of the boundary of the
face. -/
theorem faceStab_eq_toricXOperatorOfChain (x y : Fin L) :
    faceStab L x y = toricXOperatorOfChain L (∂₂ L (singleFace (x, y))) := by
  refine NQubitPauliGroupElement.ext _ _ rfl (funext fun q => ?_)
  obtain ⟨e, rfl⟩ := (toricEdgeEquiv L).surjective q
  rw [toricEdgeEquiv_apply, toricXOperatorOfChain_operators_edgeToQubitIdx,
    faceStab_operators_edgeToQubitIdx]
  exact if_congr (toricBoundary2_singleFace_eq_one_iff L x y e).symm rfl rfl

/-- The vertex check at `(x, y)` is the vertex check of
`toricHomologicalCode L`. -/
theorem vertexStab_eq_vertexStabOf (x y : Fin L) :
    vertexStab L x y = (toricHomologicalCode L).vertexStabOf (x, y) := by
  rw [vertexStab_eq_toricZOperatorOfChain, ← toricHomologicalCode_singleVtx_eq,
    ← toricHomologicalCode_cutMap_eq]
  rfl

/-- The face check at `(x, y)` is the face check of `toricHomologicalCode L`. -/
theorem faceStab_eq_faceStabOf (x y : Fin L) :
    faceStab L x y = (toricHomologicalCode L).faceStabOf (x, y) := by
  rw [faceStab_eq_toricXOperatorOfChain, ← toricHomologicalCode_singleFace_eq]
  rfl

lemma ZGenerators_eq_homologicalZGenerators :
    ZGenerators L = (toricHomologicalCode L).ZGenerators :=
  congrArg Set.range (funext fun p => vertexStab_eq_vertexStabOf L p.1 p.2)

lemma XGenerators_eq_homologicalXGenerators :
    XGenerators L = (toricHomologicalCode L).XGenerators :=
  congrArg Set.range (funext fun p => faceStab_eq_faceStabOf L p.1 p.2)

lemma generators_eq_homologicalGenerators :
    generators L = (toricHomologicalCode L).homologicalGenerators :=
  congrArg₂ (· ∪ ·) (ZGenerators_eq_homologicalZGenerators L)
    (XGenerators_eq_homologicalXGenerators L)

lemma subgroup_eq_homologicalStabilizerGroup :
    subgroup L = (toricHomologicalCode L).homologicalStabilizerGroup.toSubgroup :=
  congrArg Subgroup.closure (generators_eq_homologicalGenerators L)

/-! ## The stabilizer group -/

/-- Every Z-check commutes with every X-check. -/
lemma ZGenerators_commute_XGenerators :
    ∀ z ∈ ZGenerators L, ∀ x ∈ XGenerators L, z * x = x * z := by
  rw [ZGenerators_eq_homologicalZGenerators, XGenerators_eq_homologicalXGenerators]
  exact HomologicalCode.ZGenerators_commute_XGenerators (X := toricHomologicalCode L)

/-- The checks pairwise commute. -/
theorem generators_commute :
    ∀ g ∈ generators L, ∀ h ∈ generators L, g * h = h * g := by
  rw [generators_eq_homologicalGenerators]
  exact HomologicalCode.homologicalGenerators_commute (X := toricHomologicalCode L)

/-- `-I` is not in the subgroup generated by the checks. -/
theorem negIdentity_not_mem :
    StabilizerGroup.negIdentity (numQubits L) ∉ subgroup L := by
  rw [subgroup_eq_homologicalStabilizerGroup]
  exact (toricHomologicalCode L).negIdentity_not_mem_closure_homologicalGenerators

/-- The stabilizer group of the toric code, generated by `generatorsList L`. -/
noncomputable def stabilizerGroup : StabilizerGroup (numQubits L) :=
  StabilizerGroup.mkStabilizerFromGenerators (numQubits L) (generatorsList L)
    (by rw [listToSet_generatorsList]; exact generators_commute L)
    (by rw [listToSet_generatorsList]; exact negIdentity_not_mem L)

lemma stabilizerGroup_toSubgroup_eq :
    (stabilizerGroup L).toSubgroup = subgroup L :=
  congrArg Subgroup.closure (listToSet_generatorsList L)

/-- The stabilizer group has the same subgroup as the homological stabilizer
group of `toricHomologicalCode L`, so statements about centralizers and logical
operators transfer between the two (via
`IsNontrivialLogicalOperator_of_toSubgroup_eq`). -/
lemma stabilizerGroup_toSubgroup_eq_homologicalStabilizerGroup :
    (stabilizerGroup L).toSubgroup =
      (toricHomologicalCode L).homologicalStabilizerGroup.toSubgroup :=
  (stabilizerGroup_toSubgroup_eq L).trans (subgroup_eq_homologicalStabilizerGroup L)

end HomologicalCode

end ToricCodeN
end StabilizerGroup
end Quantum
