/-!
# The Steane code `[[7, 1, 3]]`

The CSS code of the classical `[7,4,3]` Hamming code [Steane 1996,
`arxiv:quant-ph/9601029`]. The Hamming parity-check rows (supports) are
- `r₁ = {0,1,2,4}`
- `r₂ = {0,1,3,5}`
- `r₃ = {0,2,3,6}`

and the Steane stabilizer is generated by `Z` and by `X` on each row: three
`Z`-checks and three `X`-checks.

The code is packaged by the **decide route**: the six generators form a literal
list, and every hypothesis of `Code[[7, 1]]` — pairwise commutation, phase
zero, linear independence of the check-matrix rows — is a closed decidable
statement that the kernel settles with `decide`. `−I ∉ closure` then follows
from `negIdentity_not_mem_of_indep_phase_zero_commute`.

The distance argument is the textbook one: the Hamming check matrix has as
columns the seven nonzero vectors of `𝔽₂³`, so no column is zero and no two
coincide, and `hasCodeDistance_three_of_columns` turns that into "no
nontrivial logical of weight `1` or `2`". `X` on qubits `{3, 5, 6}` is a
nontrivial logical of weight `3`.

The logical basis `X̄ = X⊗⁷`, `Z̄ = Z⊗⁷` is in `Steane7Logicals.lean`.

## Outline

- Generators `Z1`–`Z3`, `X1`–`X3` and the list `generatorsList`
- Decided hypotheses: `generators_commute`, `AllPhaseZero_generatorsList`,
  `rowsLinearIndependent_generatorsList`
- `negIdentity_not_mem`, the bundled `stabilizerGroup`
- `stabilizerCode : Code[[7, 1]]`
- Distance 3 (Hamming column condition, weight-3 witness):
  `code_has_distance_three`, `stabilizerCodeWithDistance : Code[[7, 1, 3]]`
-/

open NQubitPauliGroupElement

/-! ## Generators -/

/-- Z-check on row r₁ = {0,1,2,4}: Z on qubits 0,1,2,4 and I elsewhere. -/
def Z1 : NQubitPauliGroupElement 7 := σ[ZZZIZII]

/-- Z-check on row r₂ = {0,1,3,5}: Z on qubits 0,1,3,5 and I elsewhere. -/
def Z2 : NQubitPauliGroupElement 7 := σ[ZZIZIZI]

/-- Z-check on row r₃ = {0,2,3,6}: Z on qubits 0,2,3,6 and I elsewhere. -/
def Z3 : NQubitPauliGroupElement 7 := σ[ZIZZIIZ]

/-- X-check on row r₁ = {0,1,2,4}: X on qubits 0,1,2,4 and I elsewhere. -/
def X1 : NQubitPauliGroupElement 7 := σ[XXXIXII]

/-- X-check on row r₂ = {0,1,3,5}: X on qubits 0,1,3,5 and I elsewhere. -/
def X2 : NQubitPauliGroupElement 7 := σ[XXIXIXI]

/-- X-check on row r₃ = {0,2,3,6}: X on qubits 0,2,3,6 and I elsewhere. -/
def X3 : NQubitPauliGroupElement 7 := σ[XIXXIIX]

/-- The six generators as a list (Z-checks first, then X-checks). This is the
single source of truth for the stabilizer group and the `StabilizerCode`. -/
def generatorsList : List (NQubitPauliGroupElement 7) :=
  [Z1, Z2, Z3, X1, X2, X3]

/-! ## Decided hypotheses

Each statement below is a finite conjunction of closed facts about literal
group elements, so `decide` closes it through the global
`DecidableEq (NQubitPauliGroupElement n)` instance. Mathematically, a Z-row
and an X-row meet in an even number of qubits (`r₁ ∩ r₂ = {0, 1}`,
`r₁ ∩ r₃ = {0, 2}`, `r₂ ∩ r₃ = {0, 3}`, and each row with itself in four), and
same-type generators commute componentwise. -/

/-- All six generators pairwise commute. -/
theorem generators_commute :
    ∀ g ∈ listToSet generatorsList, ∀ h ∈ listToSet generatorsList, g * h = h * g := by
  decide

/-- Every generator has phase power 0. -/
lemma AllPhaseZero_generatorsList : AllPhaseZero generatorsList := by
  decide

/-- The check-matrix rows of the six generators are linearly independent. -/
theorem rowsLinearIndependent_generatorsList :
    rowsLinearIndependent generatorsList := by decide

/-- The generator list is an independent generating set. -/
theorem GeneratorsIndependent_7_generatorsList : GeneratorsIndependent 7 generatorsList :=
  GeneratorsIndependent_of_rowsLinearIndependent rowsLinearIndependent_generatorsList

/-! ## No `−I` in the stabilizer subgroup -/

/-- The closure of the six generators does not contain `−I`: they are phase-0,
pairwise commuting, and symplectically independent. -/
theorem negIdentity_not_mem :
    negIdentity 7 ∉ Subgroup.closure (listToSet generatorsList) :=
  negIdentity_not_mem_of_indep_phase_zero_commute generatorsList
    AllPhaseZero_generatorsList rowsLinearIndependent_generatorsList generators_commute

/-! ## Bundled `StabilizerGroup 7` -/

/-- The Steane stabilizer group, from the generator list. -/
noncomputable def stabilizerGroup : StabilizerGroup 7 :=
  mkStabilizerFromGenerators 7 generatorsList generators_commute negIdentity_not_mem

/-- The stabilizer subgroup is the closure of the generator list. -/
lemma stabilizerGroup_toSubgroup_eq :
    stabilizerGroup.toSubgroup = Subgroup.closure (listToSet generatorsList) := rfl

/-! ## The bare code `Code[[7, 1]]`

Six independent, pairwise commuting generators on seven qubits: one logical
qubit. -/

/-- The generator list as a presentation of a `[[7, 1]]` code: its 6
check-matrix rows are linearly independent. -/
def presentation : StabilizerCode.Presentation 7 1 where
  hk := by decide
  generatorsList := generatorsList
  generators_length := rfl
  generators_phaseZero := AllPhaseZero_generatorsList
  generators_independent := rowsLinearIndependent_generatorsList
  generators_commute := generators_commute
  closure_no_neg_identity := negIdentity_not_mem

/-- The Steane code as a stabilizer code `[[7, 1]]`. -/
noncomputable def stabilizerCode : Code[[7, 1]] := presentation.toCode

/-- The stabilizer code's subgroup is the closure of the generator list. -/
lemma stabilizerCode_toSubgroup_eq :
    stabilizerCode.toStabilizerGroup.toSubgroup = Subgroup.closure (listToSet generatorsList) :=
  rfl

/-! ## Distance 3

### No nontrivial logical of weight 1 or 2

The three parity-check rows of the classical `[7,4,3]` Hamming code serve as
both the `Z`-check and the `X`-check supports (the Steane code is self-dual
CSS). Column `i` of the check matrix is the set of rows containing qubit `i`;
the seven columns are the seven nonzero vectors of `𝔽₂³`, so no column is zero
and no two columns coincide. -/

/-- The Hamming parity-check rows `r₁ = {0,1,2,4}`, `r₂ = {0,1,3,5}`,
`r₃ = {0,2,3,6}`. -/
def row : Fin 3 → Finset (Fin 7) := ![{0, 1, 2, 4}, {0, 1, 3, 5}, {0, 2, 3, 6}]

/-- The `Z`-checks are `Z` along the Hamming rows. -/
lemma Z1_eq_zOn : Z1 = zOn {0, 1, 2, 4} := by decide

lemma Z2_eq_zOn : Z2 = zOn {0, 1, 3, 5} := by decide

lemma Z3_eq_zOn : Z3 = zOn {0, 2, 3, 6} := by decide

/-- The `X`-checks are `X` along the same rows. -/
lemma X1_eq_xOn : X1 = xOn {0, 1, 2, 4} := by decide

lemma X2_eq_xOn : X2 = xOn {0, 1, 3, 5} := by decide

lemma X3_eq_xOn : X3 = xOn {0, 2, 3, 6} := by decide

/-- Each `Z`-check along a Hamming row is a generator. -/
lemma zOn_row_mem (r : Fin 3) : zOn (row r) ∈ listToSet generatorsList := by
  fin_cases r <;> simp [row, generatorsList, Z1_eq_zOn, Z2_eq_zOn, Z3_eq_zOn]

/-- Each `X`-check along a Hamming row is a generator. -/
lemma xOn_row_mem (r : Fin 3) : xOn (row r) ∈ listToSet generatorsList := by
  fin_cases r <;> simp [row, generatorsList, X1_eq_xOn, X2_eq_xOn, X3_eq_xOn]

/-- Every qubit lies on some Hamming row (no zero column). -/
lemma row_cover : ∀ i : Fin 7, ∃ r, i ∈ row r := by decide

/-- Any two distinct qubits are separated by some Hamming row (distinct
columns). -/
lemma row_separate : ∀ i j : Fin 7, i ≠ j → ∃ r, (i ∈ row r ↔ j ∉ row r) := by decide

/-! ### A nontrivial logical of weight 3

`X` on `{3, 5, 6}` is `X⊗⁷ · X1`, the complement of row `r₁`: it commutes with
every check, and it anticommutes with `Z` on `{3, 5, 6}` (= `Z⊗⁷ · Z1`), which
also commutes with every check. -/

/-- `X` on qubits `{3, 5, 6}`: a nontrivial logical of weight 3. -/
def minWeightLogical : NQubitPauliGroupElement 7 := σ[IIIXIXX]

/-- `Z` on qubits `{3, 5, 6}`: a centralizer element anticommuting with
`minWeightLogical`. -/
def minWeightPartner : NQubitPauliGroupElement 7 := σ[IIIZIZZ]

lemma minWeightLogical_weight : weight minWeightLogical = 3 := by decide

lemma minWeightLogical_mem_centralizer : minWeightLogical ∈ centralizer stabilizerGroup := by
  rw [StabilizerGroup.mem_centralizer_iff_closure _ _ _ stabilizerGroup_toSubgroup_eq]
  simp only [generatorsList, listToSet_cons, listToSet_nil, Set.mem_insert_iff,
    Set.mem_empty_iff_false, or_false, forall_eq_or_imp, forall_eq]
  decide

lemma minWeightPartner_mem_centralizer : minWeightPartner ∈ centralizer stabilizerGroup := by
  rw [StabilizerGroup.mem_centralizer_iff_closure _ _ _ stabilizerGroup_toSubgroup_eq]
  simp only [generatorsList, listToSet_cons, listToSet_nil, Set.mem_insert_iff,
    Set.mem_empty_iff_false, or_false, forall_eq_or_imp, forall_eq]
  decide

/-- `X` and `Z` on `{3, 5, 6}` meet on three qubits, an odd number. -/
lemma minWeightLogical_anticommutes_minWeightPartner :
    Anticommute minWeightLogical minWeightPartner := by decide

/-- `X` on `{3, 5, 6}` is a nontrivial logical operator: it lies in the
centralizer and anticommutes with the centralizer element `minWeightPartner`. -/
lemma minWeightLogical_isNontrivial :
    IsNontrivialLogicalOperator minWeightLogical stabilizerCode.toStabilizerGroup :=
  isNontrivialLogicalOperator_of_anticommute_centralizer _ minWeightLogical_mem_centralizer
    minWeightPartner_mem_centralizer minWeightLogical_anticommutes_minWeightPartner

/-! ### The code with its distance `Code[[7, 1, 3]]` -/

/-- **The Steane code has distance 3.** Both check matrices are the Hamming
matrix, whose columns are nonzero and pairwise distinct, so no Pauli of weight
`1` or `2` is a nontrivial logical; `X` on `{3, 5, 6}` is one of weight `3`. -/
theorem code_has_distance_three : HasCodeDistance stabilizerCode 3 :=
  hasCodeDistance_three_of_columns row row (listToSet generatorsList) stabilizerCode
    stabilizerCode_toSubgroup_eq zOn_row_mem xOn_row_mem row_cover row_cover row_separate
    row_separate ⟨minWeightLogical, minWeightLogical_isNontrivial, minWeightLogical_weight⟩

/-- The Steane code packaged with its distance. -/
noncomputable def stabilizerCodeWithDistance : Code[[7, 1, 3]] where
  toStabilizerCode := stabilizerCode
  hasDistance := code_has_distance_three

end Steane7
end StabilizerGroup

end Quantum
