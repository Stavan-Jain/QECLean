import Mathlib.Tactic
import QEC.Stabilizer.Foundations.BinarySymplectic.CheckMatrixDecidable
import QEC.Stabilizer.Foundations.PauliGroup.Commutation
import QEC.Stabilizer.Foundations.PauliGroup.Notation
import QEC.Stabilizer.Framework.Core.CodeNotation
import QEC.Stabilizer.Framework.Core.CSS.CSSDistance
import QEC.Stabilizer.Framework.Core.Logical.CodeDistance
import QEC.Stabilizer.Framework.Core.Logical.LogicalOperators
import QEC.Stabilizer.Framework.Core.Stabilizer.StabilizerCode
import QEC.Stabilizer.Framework.Symplectic.Presentation
import QEC.Stabilizer.Framework.Symplectic.SymplecticSpan

/-!
# The four-qubit code `[[4, 2, 2]]`

The four-qubit detection code, also known as `C₄`: a self-dual CSS stabilizer
code encoding two logical qubits, with code distance 2. Its codespace is
spanned by the four even-parity states `(|x⟩ + |x̄⟩)/√2`, where `x̄` is the
bitwise complement of `x`, and its two generators (`n − k = 2`) are `ZZZZ` and
`XXXX`.

The code is packaged by the **decide route**: the two generators form a literal
list, and pairwise commutation, phase zero and check-matrix independence are
closed statements settled by `decide`; `−I ∉ closure` follows by
`negIdentity_not_mem_of_indep_phase_zero_commute`.

Distance 2 is `hasCodeDistance_two_of_anticommute_witness`: every weight-1
Pauli anticommutes with `ZZZZ` (local `X` or `Y`) or `XXXX` (local `Z`), and
`IXIX` is a nontrivial logical of weight 2.

The logical basis `X̄₁ = IXIX`, `X̄₂ = IIXX`, `Z̄₁ = IIZZ`, `Z̄₂ = IZIZ` is in
`FourQubit_4_2_2Logicals.lean`.

## Outline

- Generators `Z1`, `X1` and the list `generatorsList`
- Decided hypotheses: `generators_commute`, `AllPhaseZero_generatorsList`,
  `rowsLinearIndependent_generatorsList`
- `negIdentity_not_mem`, the bundled `stabilizerGroup`
- `presentation`, `stabilizerCode : Code[[4, 2]]`
- Distance 2 (weight-1 anticommute witness, weight-2 logical):
  `code_has_distance_two`, `stabilizerCodeWithDistance : Code[[4, 2, 2]]`
-/

namespace Quantum
namespace StabilizerGroup
namespace FourQubit_4_2_2

open NQubitPauliGroupElement
open scoped Pauli

/-! ## Generators -/

/-- Z-check stabilizer: `ZZZZ` (Z on every qubit). -/
def Z1 : NQubitPauliGroupElement 4 := σ[ZZZZ]

/-- X-check stabilizer: `XXXX` (X on every qubit). -/
def X1 : NQubitPauliGroupElement 4 := σ[XXXX]

/-- The two generators as a list (Z-check first, then X-check). -/
def generatorsList : List (NQubitPauliGroupElement 4) :=
  [Z1, X1]

/-! ## Decided hypotheses

`ZZZZ` and `XXXX` anticommute locally at all four qubits — an even count, so
they commute. `decide` checks the four ordered pairs, the phases, and the
check-matrix rank. -/

/-- The two generators commute. -/
lemma generators_commute :
    ∀ g ∈ listToSet generatorsList, ∀ h ∈ listToSet generatorsList, g * h = h * g := by
  decide

/-- Every generator has phase power 0. -/
lemma AllPhaseZero_generatorsList : AllPhaseZero generatorsList := by
  decide

/-- The check-matrix rows of the two generators are linearly independent. -/
lemma rowsLinearIndependent_generatorsList : rowsLinearIndependent generatorsList := by
  decide

/-! ## No `−I` in the stabilizer subgroup -/

/-- The closure of the two generators does not contain `−I`. -/
lemma negIdentity_not_mem : negIdentity 4 ∉ Subgroup.closure (listToSet generatorsList) :=
  negIdentity_not_mem_of_indep_phase_zero_commute generatorsList
    AllPhaseZero_generatorsList rowsLinearIndependent_generatorsList generators_commute

/-! ## Bundled `StabilizerGroup 4` -/

/-- The stabilizer group of the `[[4, 2, 2]]` code, generated by
`generatorsList`. -/
noncomputable def stabilizerGroup : StabilizerGroup 4 :=
  mkStabilizerFromGenerators 4 generatorsList generators_commute negIdentity_not_mem

/-- The stabilizer subgroup is the closure of the generator list. -/
lemma stabilizerGroup_toSubgroup_eq :
    stabilizerGroup.toSubgroup = Subgroup.closure (listToSet generatorsList) := rfl

/-! ## The bare code `Code[[4, 2]]`

Two independent, commuting generators on four qubits: two logical qubits. -/

/-- The generator list as a presentation of a `[[4, 2]]` code: its 2
check-matrix rows are linearly independent. -/
def presentation : StabilizerCode.Presentation 4 2 where
  hk := by decide
  generatorsList := generatorsList
  generators_length := rfl
  generators_phaseZero := AllPhaseZero_generatorsList
  generators_independent := rowsLinearIndependent_generatorsList
  generators_commute := generators_commute
  closure_no_neg_identity := negIdentity_not_mem

/-- The `[[4, 2, 2]]` code as a stabilizer code `[[4, 2]]`. -/
noncomputable def stabilizerCode : Code[[4, 2]] := presentation.toCode

/-- The stabilizer code's subgroup is the closure of the generator list. -/
lemma stabilizerCode_toSubgroup_eq :
    stabilizerCode.toStabilizerGroup.toSubgroup = Subgroup.closure (listToSet generatorsList) :=
  rfl

/-! ## Distance 2

### No nontrivial logical of weight 1

A local `X` or `Y` anticommutes with the `Z` of `ZZZZ`, and a local `Z` with the
`X` of `XXXX`, whatever the qubit. -/

/-- Every weight-1 Pauli anticommutes with some generator. -/
private lemma weight_one_anticomm_witness :
    ∀ i : Fin 4, ∀ P : PauliOperator, P ≠ .I →
      ∃ g ∈ generatorsList, Anticommute (weightOneAt i P) g := by
  decide

/-! ### A nontrivial logical of weight 2

`IXIX` meets `ZZZZ` on two qubits, so it commutes with both checks; it
anticommutes with `IIZZ` (one shared qubit), which also commutes with both. -/

/-- `IXIX`: a nontrivial logical of weight 2. -/
def minWeightLogical : NQubitPauliGroupElement 4 := σ[IXIX]

/-- `IIZZ`: a centralizer element anticommuting with `minWeightLogical`. -/
def minWeightPartner : NQubitPauliGroupElement 4 := σ[IIZZ]

/-- `IXIX` has weight 2. -/
lemma minWeightLogical_weight : weight minWeightLogical = 2 := by decide

/-- `IXIX` commutes with every element of the stabilizer. -/
lemma minWeightLogical_mem_centralizer : minWeightLogical ∈ centralizer stabilizerGroup :=
  mem_centralizer_of_commute_list stabilizerGroup_toSubgroup_eq (by decide)

/-- `IIZZ` commutes with every element of the stabilizer. -/
lemma minWeightPartner_mem_centralizer : minWeightPartner ∈ centralizer stabilizerGroup :=
  mem_centralizer_of_commute_list stabilizerGroup_toSubgroup_eq (by decide)

/-- `IXIX` and `IIZZ` meet on qubit 3 only, an odd number. -/
lemma minWeightLogical_anticommutes_minWeightPartner :
    Anticommute minWeightLogical minWeightPartner := by decide

/-- `IXIX` is a nontrivial logical operator: it lies in the centralizer and
anticommutes with the centralizer element `minWeightPartner`. -/
lemma minWeightLogical_isNontrivial :
    IsNontrivialLogicalOperator minWeightLogical stabilizerCode.toStabilizerGroup :=
  isNontrivialLogicalOperator_of_anticommute_centralizer _ minWeightLogical_mem_centralizer
    minWeightPartner_mem_centralizer minWeightLogical_anticommutes_minWeightPartner

/-! ### The code with its distance `Code[[4, 2, 2]]` -/

/-- **The `[[4, 2, 2]]` code has distance 2.** Every weight-1 Pauli
anticommutes with some generator, and `IXIX` is a nontrivial logical of
weight 2. -/
theorem code_has_distance_two : HasCodeDistance stabilizerCode 2 :=
  hasCodeDistance_two_of_anticommute_witness stabilizerCode (listToSet generatorsList)
    stabilizerCode_toSubgroup_eq weight_one_anticomm_witness
    ⟨minWeightLogical, minWeightLogical_isNontrivial, minWeightLogical_weight⟩

/-- The `[[4, 2, 2]]` code packaged with its distance. -/
noncomputable def stabilizerCodeWithDistance : Code[[4, 2, 2]] where
  toStabilizerCode := stabilizerCode
  hasDistance := code_has_distance_two

end FourQubit_4_2_2
end StabilizerGroup
end Quantum
